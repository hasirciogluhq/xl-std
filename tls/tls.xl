// std/tls/tls: the public TLS API: a client and a server for TLS 1.3 (RFC 8446) and TLS 1.2 (RFC 5246) over the raw
// TCP calls in `std/sys`. Like rustls, only forward-secret ECDHE with AEAD ciphers exists:
//   versions        TLS 1.3 preferred, TLS 1.2; nothing older (`tlsConnectVersions`, `TlsCredentials.minVersion` /
//                   `maxVersion` narrow the range). Downgrades are detected (RFC 8446 section 4.1.3, RFC 7507).
//   cipher suites   1.3: CHACHA20_POLY1305_SHA256, AES_128_GCM_SHA256, AES_256_GCM_SHA384;
//                   1.2: ECDHE_{ECDSA,RSA}_WITH_{CHACHA20_POLY1305_SHA256, AES_128_GCM_SHA256, AES_256_GCM_SHA384}
//   key exchange    1.3: x25519 (no HelloRetryRequest); 1.2: x25519, secp256r1, secp384r1
//   1.2 extras      extended master secret (RFC 7627), renegotiation_info (RFC 5746; renegotiation is refused)
//   authentication  certificate chain validated against the OS root store (`std/tls/truststore`), host name checked
//                   against subjectAltName; ECDSA P-256/P-384, RSA-PSS, and RSA PKCS#1 v1.5 for TLS 1.2. There is no
//                   way to skip validation.
//   not supported   client certificates (an empty Certificate is sent when asked), resumption / PSK / 0-RTT, ALPN,
//                   Ed25519 certificates, IPv6, OCSP / SCT.
// `tlsConnectHost` resolves the name with `std/net/dns`. Results are 0 or a negative TLS_ERR_* code. Buffers are
// mapped on connect and released by `tlsClose`. An accepted connection is an ordinary `TlsConn`.
// Layout: conn (state, codes, suites), wire (bytes), record (records, application data), keys (transcripts and key
// derivation), handshake (message reader, ECDHE, certificate list), sign (signature schemes), credentials,
// client / client13 / client12, server / server13 / server12.
export { TlsConn, TLS_OK, TLS_ERR_IO, TLS_ERR_PROTOCOL, TLS_ERR_ALERT, TLS_ERR_VERSION, TLS_ERR_CERT } from "conn"
export { TLS_ERR_SIGNATURE, TLS_ERR_FINISHED, TLS_ERR_ENTROPY, TLS_ERR_MEMORY, TLS_ERR_RETRY, TLS_ERR_UNSUPPORTED } from "conn"
export { TLS_ERR_CLOCK, TLS_ERR_DNS, TLS_ERR_AEAD, TLS_ERR_CREDENTIALS, TLS_ERR_DOWNGRADE, TLS_1_2, TLS_1_3 } from "conn"
export { tlsErrorText } from "conn"
export { tlsWrite, tlsRead, tlsClose } from "record"
export { tlsConnect, tlsConnectVersions, tlsConnectHost } from "client"
export { TlsCredentials, tlsLoadCredentialsPem, tlsLoadCredentials, tlsFreeCredentials } from "credentials"
export { tlsListen, tlsAccept } from "server"

// std/math/bigdiv: multiplication and division of unsigned integers held as little-endian arrays of 32-bit limbs.
//   Multiplication: schoolbook (Knuth, TAOCP vol. 2, section 4.3.1, Algorithm M).
//   Division: Knuth, TAOCP vol. 2, section 4.3.1, Algorithm D: normalize so the top divisor limb has its high bit set,
//   estimate each quotient limb from the top two limbs, correct it with the test on the third limb, and add back once
//   when the estimate was one too large. The contract is q * v + r = u with 0 <= r < v; tested by that identity.
// The limb counts are explicit; results are written in full (zeros included). Not constant-time.

/// out = a * b; a has na limbs, b has nb limbs, out has na + nb limbs.
export fn bigMul(a: *u32, na: usize, b: *u32, nb: usize, out: *u32) {
    local i: usize = 0
    while i < na + nb {
        out[i] = 0
        i = i + 1
    }
    i = 0
    while i < na {
        local carry: u64 = 0
        local j: usize = 0
        while j < nb {
            local t: u64 = (out[i + j] as u64) + (a[i] as u64) * (b[j] as u64) + carry
            out[i + j] = (t & 0xffffffff) as u32
            carry = t >> 32
            j = j + 1
        }
        out[i + nb] = carry as u32
        i = i + 1
    }
}

/// The number of significant limbs of a (its length without the zero top limbs).
export fn bigLen(a: *u32, n: usize) -> usize {
    local len: usize = n
    while len > 0 && a[len - 1] == 0 { len = len - 1 }
    return len
}

/// Quotient and remainder of u (m limbs) by v (n limbs): q gets m limbs (the high ones are zero), r gets n limbs.
/// Returns false when v is zero.
export fn bigDivMod(u: *u32, m: usize, v: *u32, n: usize, q: *u32, r: *u32) -> bool {
    local nn: usize = bigLen(v, n)
    if nn == 0 { return false }
    local i: usize = 0
    while i < m {
        q[i] = 0
        i = i + 1
    }
    i = 0
    while i < n {
        r[i] = 0
        i = i + 1
    }
    local mm: usize = bigLen(u, m)
    if mm < nn {
        i = 0
        while i < mm {
            r[i] = u[i]
            i = i + 1
        }
        return true
    }
    if nn == 1 {
        local d: u64 = v[0] as u64
        local rem: u64 = 0
        local k: usize = mm
        while k > 0 {
            k = k - 1
            local cur: u64 = (rem << 32) | (u[k] as u64)
            q[k] = (cur / d) as u32
            rem = cur % d
        }
        r[0] = rem as u32
        return true
    }
    // normalize: shift so the top limb of v has its high bit set
    local s: u32 = 0
    local top: u32 = v[nn - 1]
    while (top & 0x80000000) == 0 {
        top = top << 1
        s = s + 1
    }
    local vn: [u32; 130]
    local un: [u32; 131]
    i = nn
    while i > 0 {
        i = i - 1
        local hi: u32 = v[i] << s
        if s > 0 && i > 0 { hi = hi | (v[i - 1] >> (32 - s)) }
        vn[i] = hi
    }
    un[mm] = 0
    if s > 0 { un[mm] = u[mm - 1] >> (32 - s) }
    i = mm
    while i > 0 {
        i = i - 1
        local lo: u32 = u[i] << s
        if s > 0 && i > 0 { lo = lo | (u[i - 1] >> (32 - s)) }
        un[i] = lo
    }
    local base: u64 = 0x100000000
    local j: usize = mm - nn + 1
    while j > 0 {
        j = j - 1
        // estimate qhat from the top two limbs of the current remainder
        local num: u64 = ((un[j + nn] as u64) << 32) | (un[j + nn - 1] as u64)
        local qhat: u64 = num / (vn[nn - 1] as u64)
        local rhat: u64 = num % (vn[nn - 1] as u64)
        while qhat >= base || qhat * (vn[nn - 2] as u64) > ((rhat << 32) | (un[j + nn - 2] as u64)) {
            qhat = qhat - 1
            rhat = rhat + (vn[nn - 1] as u64)
            if rhat >= base { break }
        }
        // multiply and subtract qhat * vn from un[j .. j + nn]
        local borrow: u64 = 0
        local carry: u64 = 0
        i = 0
        while i < nn {
            local p: u64 = qhat * (vn[i] as u64) + carry
            carry = p >> 32
            local sub: u64 = (un[i + j] as u64) - (p & 0xffffffff) - borrow
            un[i + j] = (sub & 0xffffffff) as u32
            borrow = (sub >> 63) & 1
            i = i + 1
        }
        local sub2: u64 = (un[j + nn] as u64) - carry - borrow
        un[j + nn] = (sub2 & 0xffffffff) as u32
        if ((sub2 >> 63) & 1) != 0 {
            // the estimate was one too large: add the divisor back
            qhat = qhat - 1
            local c: u64 = 0
            i = 0
            while i < nn {
                local t: u64 = (un[i + j] as u64) + (vn[i] as u64) + c
                un[i + j] = (t & 0xffffffff) as u32
                c = t >> 32
                i = i + 1
            }
            un[j + nn] = ((un[j + nn] as u64) + c) as u32
        }
        q[j] = qhat as u32
    }
    // remainder: un[0 .. nn) shifted right by s
    i = 0
    while i < nn {
        local w: u32 = un[i] >> s
        if s > 0 { w = w | (un[i + 1] << (32 - s)) }
        r[i] = w
        i = i + 1
    }
    return true
}

// std/compress: DEFLATE (RFC 1951), zlib (RFC 1950) and gzip (RFC 1952) in both directions, and tar archives. Data is a String in and a
// String (or a Result of one, for decoding) out; decoders take the largest output they may produce, so hostile input cannot exhaust memory.
export * from "error"
export * from "inflate"
export * from "deflate"
export * from "zlib"
export * from "gzip"

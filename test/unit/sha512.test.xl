// SHA-512 / SHA-384 known-answer tests.
from "std/testing" import Suite, T, suiteInit, test, suiteRun, expectEq, expect
from "std/crypto/hash/sha512" import sha512, sha384, Sha512, sha512Init, sha384Init, sha512Update, sha512Final
from "std" import print, strlen

fn hexDigit(v: u8) -> u8 {
    if v < 10 { return 48 + v }
    return 87 + v
}

fn toHex(d: *u8, n: usize, out: *u8) {
    local i: usize = 0
    while i < n {
        out[i * 2] = hexDigit(d[i] >> 4)
        out[i * 2 + 1] = hexDigit(d[i] & 15)
        i = i + 1
    }
    out[n * 2] = 0
}

fn same(a: *u8, b: *u8) -> bool {
    local i: usize = 0
    while a[i] != 0 || b[i] != 0 {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    return true
}

global failures: i32 = 0

fn fail(name: *u8, got: *u8) {
    failures = failures + 1
    print("FAIL ")
    print(name)
    print("\n")
    print(got)
    print("\n")
}

@entry fn main() -> i32 {
    local s: Suite
    suiteInit(&s)
    test(&s, "SHA-512 and SHA-384 vectors", checks)
    test(&s, "streaming state", streaming)
    return suiteRun(&s)
}

fn checks(t: *T) {
    local d: [u8; 64]
    local hex: [u8; 129]
    sha512("abc", 3, &d[0])
    toHex(&d[0], 64, &hex[0])
    if !same(&hex[0], "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f") { fail("sha512 abc", &hex[0]) }
    sha512("", 0, &d[0])
    toHex(&d[0], 64, &hex[0])
    if !same(&hex[0], "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e") { fail("sha512 empty", &hex[0]) }
    sha384("abc", 3, &d[0])
    toHex(&d[0], 48, &hex[0])
    if !same(&hex[0], "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7") { fail("sha384 abc", &hex[0]) }
    local m: *u8 = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"
    sha512(m, strlen(m), &d[0])
    toHex(&d[0], 64, &hex[0])
    if !same(&hex[0], "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909") { fail("sha512 two-block", &hex[0]) }
    expectEq(t, failures as i64, 0)
}

// The streaming state, fed in uneven pieces across the 128-byte block edge, matches the one-shot digest; a final in
// the middle leaves the state running.
fn streaming(t: *T) {
    local buf: [u8; 300]
    for i in 0..300 { buf[i] = (i * 7) as u8 }
    local m: *u8 = &buf[0]
    local n: usize = 300
    local want: [u8; 64]
    local got: [u8; 64]
    local s: Sha512
    sha512(m, n, &want[0])
    sha512Init(&s)
    sha512Update(&s, m, 5)
    sha512Final(&s, &got[0])
    sha512Update(&s, &m[5], 130)
    sha512Update(&s, &m[135], n - 135)
    sha512Final(&s, &got[0])
    expect(t, ctEqual(&got[0], &want[0], 64), "sha512 streamed")
    sha384(m, n, &want[0])
    sha384Init(&s)
    for i in 0..n { sha512Update(&s, &m[i], 1) }
    sha512Final(&s, &got[0])
    expect(t, ctEqual(&got[0], &want[0], 48), "sha384 streamed")
    sha384("", 0, &want[0])
    sha384Init(&s)
    sha512Final(&s, &got[0])
    expect(t, ctEqual(&got[0], &want[0], 48), "sha384 empty")
}

fn ctEqual(a: *u8, b: *u8, n: usize) -> bool {
    for i in 0..n { if a[i] != b[i] { return false } }
    return true
}

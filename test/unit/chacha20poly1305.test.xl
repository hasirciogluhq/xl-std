// ChaCha20-Poly1305 known-answer test (RFC 8439 section 2.8.2) plus tamper / round-trip checks.
from "std/testing" import Suite, T, suiteInit, test, suiteRun, expectEq
from "std/crypto/cipher/chacha20poly1305" import aeadSeal, aeadOpen
from "std" import print, strlen

fn hexDigit(v: u8) -> u8 {
    if v < 10 { return 48 + v }
    return 87 + v
}

fn toHex(d: *u8, n: usize, out: *u8) {
    local i: usize = 0
    while i < n {
        out[i * 2] = hexDigit(d[i] >> 4)
        out[i * 2 + 1] = hexDigit(d[i] & 15)
        i = i + 1
    }
    out[n * 2] = 0
}

fn same(a: *u8, b: *u8) -> bool {
    local i: usize = 0
    while a[i] != 0 || b[i] != 0 {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    return true
}

global failures: i32 = 0

fn expect(ok: bool, name: *u8) {
    if !ok {
        failures = failures + 1
        print("FAIL ")
        print(name)
        print("\n")
    }
}

@entry fn main() -> i32 {
    local s: Suite
    suiteInit(&s)
    test(&s, "RFC 8439 AEAD vector", checks)
    return suiteRun(&s)
}

fn checks(t: *T) {
    local key: [u8; 32]
    local i: usize = 0
    while i < 32 {
        key[i] = (0x80 + i) as u8
        i = i + 1
    }
    local nonce: [u8; 12]
    nonce[0] = 0x07
    nonce[1] = 0
    nonce[2] = 0
    nonce[3] = 0
    i = 0
    while i < 8 {
        nonce[4 + i] = (0x40 + i) as u8
        i = i + 1
    }
    local aad: [u8; 12]
    aad[0] = 0x50
    aad[1] = 0x51
    aad[2] = 0x52
    aad[3] = 0x53
    i = 0
    while i < 8 {
        aad[4 + i] = (0xc0 + i) as u8
        i = i + 1
    }
    local msg: *u8 = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."
    local n: usize = strlen(msg)
    local ct: [u8; 128]
    local tag: [u8; 16]
    aeadSeal(&key[0], &nonce[0], &aad[0], 12, msg, n, &ct[0], &tag[0])
    local hex: [u8; 40]
    toHex(&tag[0], 16, &hex[0])
    expect(same(&hex[0], "1ae10b594f09e26a7e902ecbd0600691"), "tag")
    toHex(&ct[0], 16, &hex[0])
    expect(same(&hex[0], "d31a8d34648e60db7b86afbc53ef7ec2"), "ciphertext head")

    local pt: [u8; 128]
    expect(aeadOpen(&key[0], &nonce[0], &aad[0], 12, &ct[0], n, &tag[0], &pt[0]), "open")
    pt[n] = 0
    expect(same(&pt[0], msg), "round trip")
    ct[5] = ct[5] ^ 1
    expect(!aeadOpen(&key[0], &nonce[0], &aad[0], 12, &ct[0], n, &tag[0], &pt[0]), "tamper rejected")
    expectEq(t, failures as i64, 0)
}

// Containers: HashMap, HashSet, Deque, BinaryHeap, BTreeMap, Box, Rc and Arc, plus the Vec/slice
// algorithms and the iterator adaptors that sit beside them (std/collections).
from "std/testing" import Suite, T, suiteInit, test, suiteRun, expectEq, expectEqUInt
from "std" import print, String, Vec, Option
from "std/collections/hashmap" import HashMap
from "std/collections/hashset" import HashSet
from "std/collections/deque" import Deque
from "std/collections/binaryheap" import BinaryHeap
from "std/collections/btreemap" import BTreeMap
from "std/collections/box" import Box, boxOf
from "std/collections/rc" import Rc, rcOf
from "std/collections/arc" import Arc, arcOf
from "std/collections/hash" import I32Key, siphash13
import "std/str/string" as s
import "std/collections/slice" as sl
import "std/collections/iter" as it

global failures: i32 = 0

fn check(name: *u8, ok: bool) {
    if !ok {
        failures = failures + 1
        print("FAIL ")
        print(name)
        print("\n")
    }
}

// An element type that needs drop: counts creations and drops, so a leak or a double free shows up.
global made: i32 = 0
global dropped: i32 = 0

class Tracked {
    id: i32

    fn init(self, id: i32) {
        self.id = id
        made = made + 1
    }

    fn drop(self) {
        dropped = dropped + 1
    }
}

// The comparators these containers take: a `fn(*T, *T) -> i32`, never a capturing closure.
fn cmpI32(a: *i32, b: *i32) -> i32 {
    if *a < *b { return -1 }
    if *b < *a { return 1 }
    return 0
}

fn cmpKey(a: *I32Key, b: *I32Key) -> i32 {
    if a.v < b.v { return -1 }
    if b.v < a.v { return 1 }
    return 0
}

fn cmpTracked(a: *Tracked, b: *Tracked) -> i32 {
    if a.id < b.id { return -1 }
    if b.id < a.id { return 1 }
    return 0
}

fn hashMapChecks(t: *T) {
    local m: HashMap<I32Key, i32> = HashMap<I32Key, i32>()
    for i in 0..20 { m.put(I32Key { v: i }, i * 3) }
    check("HashMap keeps every key", m.length() == 20)
    check("HashMap reads a value", *m.get(I32Key { v: 7 }).unwrap() == 21)
    check("HashMap misses a key", m.get(I32Key { v: 100 }).isNone())
    // Replacing a key keeps the length and stores the new value.
    m.put(I32Key { v: 7 }, 0)
    check("HashMap replaces in place", m.length() == 20 && *m.get(I32Key { v: 7 }).unwrap() == 0)
    check("HashMap containsKey", m.containsKey(I32Key { v: 3 }))
    // Iteration visits every live entry exactly once.
    local sum: i32 = 0
    local seen: i32 = 0
    for kv in m {
        local (k, v) = kv
        sum += *v
        seen++
    }
    check("HashMap iterates every entry", seen == 20)
    // Every value was `key * 3`, and key 7 was replaced with 0 above, so the total is 3 * (0..19)
    // minus the 21 the original key 7 held.
    local wantSum: i32 = 3 * (19 * 20 / 2) - 21
    check("HashMap iteration total", sum == wantSum)
    check("HashMap removes", m.remove(I32Key { v: 3 }).isSome() && m.length() == 19)
    check("HashMap remove of a missing key", m.remove(I32Key { v: 3 }).isNone())
    m.clear()
    check("HashMap clear", m.length() == 0 && m.isEmpty())

    // String keys go through HashKey on String.
    local strs: HashMap<String, i32> = HashMap<String, i32>()
    local one: String = String("one")
    local two: String = String("two")
    strs.put(one, 1)
    strs.put(two, 2)
    local probe: String = String("two")
    check("HashMap String key", *strs.get(probe).unwrap() == 2)
    local absent: String = String("three")
    check("HashMap String miss", strs.get(absent).isNone())
}

fn hashSetChecks(t: *T) {
    local set: HashSet<I32Key> = HashSet<I32Key>()
    for i in 0..20 { set.add(I32Key { v: i % 7 }) }
    check("HashSet ignores duplicates", set.length() == 7)
    check("HashSet contains", set.contains(I32Key { v: 5 }))
    check("HashSet remove", set.remove(I32Key { v: 5 }) && set.length() == 6)
    check("HashSet remove of a missing key", !set.remove(I32Key { v: 5 }))
    local seen: i32 = 0
    for k in set {
        seen++
    }
    check("HashSet iterates every key", seen == 6)
}

fn dequeChecks(t: *T) {
    local d: Deque<i32> = Deque<i32>()
    check("Deque starts empty", d.isEmpty())
    for i in 0..4 { d.pushBack(i) }
    for i in 4..8 { d.pushFront(i) }
    check("Deque length", d.length() == 8)
    // The logical order is 7 6 5 4 0 1 2 3.
    check("Deque front", *d.front().unwrap() == 7)
    check("Deque back", *d.back().unwrap() == 3)
    check("Deque popFront", d.popFront().unwrap() == 7)
    check("Deque popBack", d.popBack().unwrap() == 3)
    check("Deque shrinks", d.length() == 6)
    // Grow past the first ring so the wrap is exercised.
    for i in 0..40 { d.pushBack(i) }
    check("Deque grows past one ring", d.length() == 46)
    // After the two pops the order is 6 5 4 0 1 2, then the 40 appended values.
    local wantOrder: Vec<i32> = Vec<i32>()
    for i in 0..3 { wantOrder.push(6 - i) }
    for i in 0..3 { wantOrder.push(i) }
    for i in 0..40 { wantOrder.push(i) }
    local ok: bool = true
    for i in 0..wantOrder.length() {
        if d.popFront().unwrap() != *wantOrder.get(i) { ok = false }
    }
    check("Deque keeps order after wrapping", ok)
    check("Deque after draining", d.isEmpty())
    d.clear()
    check("Deque clear", d.isEmpty() && d.popFront().isNone())
}

fn heapChecks(t: *T) {
    local h: BinaryHeap<i32> = BinaryHeap<i32>(cmpI32)
    for x in [5, 1, 9, 3, 7, 2, 8, 6, 4, 0] { h.push(*x) }
    check("BinaryHeap length", h.length() == 10)
    check("BinaryHeap peek is the max", *h.peek().unwrap() == 9)
    local ok: bool = true
    local want: i32 = 9
    while !h.isEmpty() {
        if h.pop().unwrap() != want { ok = false }
        want--
    }
    check("BinaryHeap pops descending", ok && want == -1)

    // fromVec heaps an existing vector in one pass.
    local v: Vec<i32> = Vec<i32>()
    for x in [4, 2, 8, 6] { v.push(*x) }
    local h2: BinaryHeap<i32> = BinaryHeap<i32>(cmpI32)
    h2.fromVec(v)
    check("BinaryHeap fromVec", h2.pop().unwrap() == 8 && h2.pop().unwrap() == 6)
}

fn btreeChecks(t: *T) {
    local m: BTreeMap<I32Key, i32> = BTreeMap<I32Key, i32>(cmpKey)
    // Insert out of order so the sorted invariant matters.
    for x in [5, 1, 9, 3, 7] { m.put(I32Key { v: *x }, *x * 10) }
    check("BTreeMap length", m.length() == 5)
    local probe7: I32Key = I32Key { v: 7 }
    check("BTreeMap reads", *m.get(&probe7).unwrap() == 70)
    check("BTreeMap firstKey", m.firstKey().unwrap().v == 1)
    check("BTreeMap lastKey", m.lastKey().unwrap().v == 9)
    // Iteration is in key order, the whole point of this map.
    local order: Vec<i32> = Vec<i32>()
    for kv in m {
        local (k, v) = kv
        order.push(k.v)
    }
    check("BTreeMap iterates in key order", order.length() == 5 &&
        *order.get(0) == 1 && *order.get(1) == 3 && *order.get(2) == 5 &&
        *order.get(3) == 7 && *order.get(4) == 9)
    local probe5a: I32Key = I32Key { v: 5 }
    m.put(probe5a, 0)
    check("BTreeMap replaces", m.length() == 5)
    local probe5: I32Key = I32Key { v: 5 }
    check("BTreeMap replaced value", *m.get(&probe5).unwrap() == 0)
    local probe3: I32Key = I32Key { v: 3 }
    check("BTreeMap removes", m.remove(&probe3).unwrap() == 30 && m.length() == 4)
    check("BTreeMap remove of a missing key", m.remove(&probe3).isNone())
}

fn boxChecks(t: *T) {
    local before: i32 = dropped
    {
        local b: Box<Tracked> = boxOf(Tracked(7))
        check("Box holds the value", b.get().id == 7 && !b.isEmpty())
        check("Box did not drop early", dropped == before)
        local got: Tracked = b.take()
        check("Box take returns the value", got.id == 7 && b.isEmpty())
    }
    check("Box drops the value once", dropped == before + 1)
}

fn rcChecks(t: *T) {
    local before: i32 = dropped
    {
        local a: Rc<Tracked> = rcOf(Tracked(9))
        local c: Rc<Tracked> = a.clone()
        check("Rc count is 2", a.strongCount() == 2)
        check("Rc shares the value", a.get().id == 9 && c.get().id == 9)
        check("Rc did not drop early", dropped == before)
    }
    check("Rc drops once for the last owner", dropped == before + 1)
}

fn arcChecks(t: *T) {
    local before: i32 = dropped
    {
        local a: Arc<Tracked> = arcOf(Tracked(11))
        local c: Arc<Tracked> = a.clone()
        check("Arc count is 2", a.strongCount() == 2)
        check("Arc shares the value", c.get().id == 11)
        check("Arc did not drop early", dropped == before)
    }
    check("Arc drops once for the last owner", dropped == before + 1)
}

fn vecAlgorithmChecks(t: *T) {
    local v: Vec<i32> = Vec<i32>()
    for x in [5, 3, 9, 1, 7, 2, 8, 4, 6, 0] { v.push(*x) }
    v.sort()
    local sorted: bool = true
    for i in 0..v.length() {
        if *v.get(i) != i as i32 { sorted = false }
    }
    check("Vec.sort orders", sorted)
    check("Vec.binarySearch finds", v.binarySearch(7).unwrap() == 7)
    check("Vec.binarySearch misses", v.binarySearch(100).isNone())
    check("Vec.contains", v.contains(3) && !v.contains(100))
    check("Vec.indexOf", v.indexOf(4).unwrap() == 4)
    v.reverse()
    check("Vec.reverse", *v.get(0) == 9 && *v.get(9) == 0)
    v.sort()
    local dup: Vec<i32> = Vec<i32>()
    for x in [1, 1, 2, 2, 2, 3] { dup.push(*x) }
    dup.dedup()
    check("Vec.dedup of adjacent runs", dup.length() == 3 && *dup.get(1) == 2 && *dup.get(2) == 3)

    // A String element uses the ...By forms with a borrowed comparator.
    local strs: Vec<String> = Vec<String>()
    strs.push(String("pear"))
    strs.push(String("apple"))
    strs.push(String("fig"))
    strs.sortBy(s.compareString)
    check("Vec<String>.sortBy", strs.get(0).equals("apple") && strs.get(2).equals("pear"))
    check("Vec<String>.containsBy", strs.containsBy(isApple))
    check("Vec<String>.indexOfBy", strs.indexOfBy(isFig).unwrap() == 1)
}

fn cmpI32Pair(a: *i32, b: *i32) -> i32 { return cmpI32(a, b) }
fn dbl(x: *i32) -> i32 { return *x * 2 }
fn even(x: *i32) -> bool { return *x % 2 == 0 }

fn sliceChecks(t: *T) {
    failures = 0
    local a: [i32; 8] = [5, 3, 9, 1, 7, 2, 8, 4]
    sl.sortSlice<i32>(a[0..8], cmpI32Pair)
    check("sortSlice orders", a[0] == 1 && a[7] == 9)
    check("containsSlice", sl.containsSlice<i32>(a[0..8], 7) && !sl.containsSlice<i32>(a[0..8], 100))
    check("indexOfSlice", sl.indexOfSlice<i32>(a[0..8], 7) == 5)
    check("indexOfBySlice", sl.indexOfBySlice<i32>(a[0..8], even) == 1)
    sl.reverseSlice<i32>(a[0..8])
    check("reverseSlice", a[0] == 9 && a[7] == 1)
    sl.sortSlice<i32>(a[0..8], cmpI32Pair)
    sl.dedupSlice<i32>(a[0..8])
    check("dedupSlice keeps the length of a distinct run", a[0] == 1 && a[7] == 9)
}

fn iterChecks(t: *T) {
    failures = 0
    local v: Vec<i32> = Vec<i32>()
    for x in [1, 2, 3, 4, 5] { v.push(*x) }
    local mi: it.MapIter<i32, i32> = it.mapIter<i32, i32>(&v, dbl)
    local doubled: Vec<i32> = it.collect<i32, it.MapIter<i32, i32>>(&mi)
    check("mapIter doubles", doubled.length() == 5 && *doubled.get(0) == 2 && *doubled.get(4) == 10)
    // FilterIter yields a pointer into the source, so its element type is `*i32`.
    local fi: it.FilterIter<i32> = it.filterIter<i32>(&v, even)
    local evens: Vec<*i32> = it.collect<*i32, it.FilterIter<i32>>(&fi)
    check("filterIter keeps evens", evens.length() == 2 && **(evens.get(0)) == 2 && **(evens.get(1)) == 4)
    local ei: it.EnumerateIter<i32> = it.enumerateIter<i32>(&v)
    local pairs: Vec<(*i32, usize)> = it.collect<(*i32, usize), it.EnumerateIter<i32>>(&ei)
    local first: (*i32, usize) = *pairs.get(0)
    check("enumerateIter pairs the index", pairs.length() == 5 && *first.0 == 1 && first.1 == 0)
    local other: Vec<i32> = Vec<i32>()
    for x in [10, 20] { other.push(*x) }
    local zi: it.ZipIter<i32, i32> = it.zipIter<i32, i32>(&v, &other)
    local zipped: Vec<(*i32, *i32)> = it.collect<(*i32, *i32), it.ZipIter<i32, i32>>(&zi)
    check("zipIter stops at the shorter", zipped.length() == 2)
}

fn isApple(x: *String) -> bool {
    return x.equals("apple")
}

fn isFig(x: *String) -> bool {
    return x.equals("fig")
}

fn hashmapCases(t: *T) {
    failures = 0
    hashMapChecks(t)
    expectEq(t, failures as i64, 0)
}

fn hashsetCases(t: *T) {
    failures = 0
    hashSetChecks(t)
    expectEq(t, failures as i64, 0)
}

fn dequeCases(t: *T) {
    failures = 0
    dequeChecks(t)
    expectEq(t, failures as i64, 0)
}

fn binaryheapCases(t: *T) {
    failures = 0
    heapChecks(t)
    expectEq(t, failures as i64, 0)
}

fn btreemapCases(t: *T) {
    failures = 0
    btreeChecks(t)
    expectEq(t, failures as i64, 0)
}

fn boxCases(t: *T) {
    failures = 0
    boxChecks(t)
    expectEq(t, failures as i64, 0)
}

fn rcCases(t: *T) {
    failures = 0
    rcChecks(t)
    expectEq(t, failures as i64, 0)
}

fn arcCases(t: *T) {
    failures = 0
    arcChecks(t)
    expectEq(t, failures as i64, 0)
}

fn vecalgorithmsCases(t: *T) {
    failures = 0
    vecAlgorithmChecks(t)
    expectEq(t, failures as i64, 0)
}

fn sliceCases(t: *T) {
    sliceChecks(t)
    expectEq(t, failures as i64, 0)
}

fn iterAdaptorCases(t: *T) {
    iterChecks(t)
    expectEq(t, failures as i64, 0)
}

// SipHash-1-3 with the reference key 00..0f over the message 00..n-1, the layout of the reference
// implementation's test vectors (https://github.com/veorq/SipHash). The values cover the empty
// message, a partial block, one full block, a block plus a tail, and a long run of blocks.
fn siphashCases(t: *T) {
    local msg: [u8; 64]
    for i in 0..64 { msg[i] = i as u8 }
    local cases: [(usize, u64); 5] = [
        (0, 12370263754033579228), (7, 15245385783003124032), (8, 3931806377309739662),
        (15, 15213397504630561110), (63, 11320237892036178856),
    ]
    for c in cases {
        expectEqUInt(t, siphash13(0x0706050403020100, 0x0f0e0d0c0b0a0908, &msg[0], c.0), c.1)
    }
}

@entry fn main() -> i32 {
    local s: Suite
    suiteInit(&s)
    test(&s, "siphash-1-3 vectors", siphashCases)
    test(&s, "hash map", hashmapCases)
    test(&s, "hash set", hashsetCases)
    test(&s, "deque", dequeCases)
    test(&s, "binary heap", binaryheapCases)
    test(&s, "btree map", btreemapCases)
    test(&s, "box", boxCases)
    test(&s, "rc", rcCases)
    test(&s, "arc", arcCases)
    test(&s, "vec algorithms", vecalgorithmsCases)
    test(&s, "slice algorithms", sliceCases)
    test(&s, "iterator adaptors", iterAdaptorCases)
    return suiteRun(&s)
}

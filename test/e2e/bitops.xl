// Bit operators: & | ^ ~ << >> (Go-style precedence: `& << >>` bind like `*`, `| ^` like `+`).
from "std" import print

global failures: i32 = 0
global mask: u32 = 0xff00 | 0x00f0
global shifted: u64 = 1 << 40

fn check(name: *u8, got: u64, want: u64) {
    if got != want {
        failures = failures + 1
        print("FAIL ")
        print(name)
        print(": got ")
        print(got)
        print(", want ")
        print(want)
        print("\n")
    }
}

fn rotr32(x: u32, n: u32) -> u32 {
    return (x >> n) | (x << (32 - n))
}

@entry fn main() -> i32 {
    local a: u32 = 0xf0f0f0f0
    local b: u32 = 0x0ff00ff0
    check("and", (a & b) as u64, 0x00f000f0)
    check("or", (a | b) as u64, 0xfff0fff0)
    check("xor", (a ^ b) as u64, 0xff00ff00)
    check("not", (~a) as u64, 0x0f0f0f0f)
    check("not8", (~(5 as u8)) as u64, 250)
    check("shl", (1 as u32 << 31) as u64, 0x80000000)
    check("shl-wrap", (0xffffffff as u32 << 4) as u64, 0xfffffff0)
    check("shr", (a >> 28) as u64, 0xf)
    check("rotr", rotr32(0x80000001, 4) as u64, 0x18000000)

    // counts >= width give 0 (no poison), whatever the count type
    local big: usize = 32
    check("shl-over", (a << big) as u64, 0)
    check("shr-over", (a >> 40) as u64, 0)

    // signed >> is arithmetic
    local n: i64 = -17
    check("sar", (n >> 2) as u64, (-5) as u64)
    local m: i32 = -1
    check("sar-over", (m >> 99) as u64, (-1 as i64) as u64)
    check("sar-small", (-8 as i8 >> 1) as i64 as u64, (-4 as i64) as u64)

    // precedence: `&` like `*`, `|` like `+`
    check("prec1", (1 | 2 & 3) as u64, 3)
    check("prec2", (2 + 1 << 2) as u64, 6)    // 2 + (1 << 2)
    check("prec3", (6 & 3 + 1) as u64, 3)     // (6 & 3) + 1
    check("prec4", (1 ^ 3 | 4) as u64, 6)

    // mixed use
    local byte: u8 = 0xab
    check("hi-nibble", ((byte >> 4) & 0xf) as u64, 0xa)
    check("lo-nibble", (byte & 0xf) as u64, 0xb)
    local word: u32 = (byte as u32) << 24 | (0x12 as u32) << 16
    check("pack", word as u64, 0xab120000)

    // constants
    check("global-or", mask as u64, 0xfff0)
    check("global-shl", shifted, 1099511627776)

    if failures == 0 {
        print("bitops ok\n")
        return 0
    }
    return 1
}

// M:N scheduler: many tasks, yielding, atomics, waitAll.
from "std" import print, assert, spawn, waitAll, yield, cpu

global done: u32 = 0
global sum: u64 = 0

fn task(arg: *void) {
    local n: usize = arg as usize
    local i: i32 = 0
    while i < 5 {
        yield()
        i = i + 1
    }
    __builtin_atomicAdd(&sum, n as u64, MemoryOrder.seqCst)
    __builtin_atomicAdd(&done, 1, MemoryOrder.seqCst)
}

@entry fn main() -> i32 {
    local i: usize = 1
    while i <= 200 {
        spawn(task, i as *void)
        i = i + 1
    }
    waitAll()
    print(sum as i64)
    print("\n")
    assert!(done == 200)
    assert!(sum == 20100)
    assert!(cpu() >= 1)
    return 0
}

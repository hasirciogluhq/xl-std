// Native end-to-end runner, written in xlang with the stdlib's own `std/os/process`. It reads the table `tests.txt` (see its header),
// builds every program with `xlc` against this repository's stdlib, starts it as a child process and compares the exit code and the
// output. Exit status: 0 when every entry passed, 1 otherwise. Runs on Linux and macOS (an entry point with arguments is not available
// on Windows); the Docker and CrossOver legs and the TLS server/client pairs are in `run.sh`.
//
//   xlc test/e2e/runner.xl -M std=. --import std -DfeatureDefaultAllocator=true -o e2e-runner
//   ./e2e-runner <path/to/xlc> <stdlib root> <test/e2e directory> [name-filter]
from "std" import println, String, Vec, Option, split, fromC, toI64, fsReadAllString, fsRemove
from "std/os/process" import Command

define BINARY = "xlang_e2e.bin"

/// The compiler call for `source`: `xlc <source> -M std=<root> --import std -DfeatureDefaultAllocator=true [flag] -o <out>`.
fn compiler(xlc: *String, root: *String, source: *String, flag: *String, out: str) -> Command {
    local cmd: Command = Command(xlc.clone())
    cmd.arg(source.clone())
    cmd.arg(String("-M"))
    local std: String = String("std=")
    std.append(root)
    cmd.arg(std)
    cmd.arg(String("--import"))
    cmd.arg(String("std"))
    cmd.arg(String("-DfeatureDefaultAllocator=true"))
    if flag.length() > 0 { cmd.arg(flag.clone()) }
    cmd.arg(String("-o"))
    cmd.arg(String(out))
    return cmd
}

/// `<dir>/<name>.xl`.
fn sourceOf(dir: *String, name: *String) -> String {
    local path: String = dir.clone()
    path.append("/")
    path.append(name)
    path.append(".xl")
    return path
}

fn fail(label: *String, why: str, text: *String) {
    println("FAIL [{}] {}", label, why)
    local shown: String = text.slice(0, text.length() > 600 ? 600 : text.length())
    if shown.length() > 0 { println("{}", &shown) }
}

/// The exit code the way a shell reports it: the status, or 128 + the signal; -1 when the command cannot be started.
fn exitCode(cmd: *Command) -> i32 {
    return cmd.status.signal != 0 ? 128 + cmd.status.signal : cmd.status.code
}

/// `run` entry: build the program, run it, compare exit code and text.
fn runTest(xlc: *String, root: *String, dir: *String, fields: *Vec<String>) -> bool {
    local name: *String = fields.get(1)
    local none: String = String()
    local source: String = sourceOf(dir, name)
    local build: Command = compiler(xlc, root, &source, &none, BINARY)
    if build.output().isSome() || !build.status.success {
        fail(name, "build", &build.errText)
        return false
    }
    local program: Command = Command(String("./xlang_e2e.bin"))
    if program.output().isSome() {
        fail(name, "the program does not start", &none)
        return false
    }
    local want: i64 = 0
    toI64(fields.get(2).asStr(), &want)
    local text: *String = fields.get(3)
    if exitCode(&program) as i64 != want {
        fail(name, "exit status differs from the table", &program.outText)
        println("  got {}, want {}", exitCode(&program), want)
        return false
    }
    if text.length() > 0 && !program.outText.contains(text.asStr()) {
        fail(name, "output lacks the expected text", &program.outText)
        return false
    }
    println("ok   [{}]", name)
    return true
}

/// `diag` entry: the build must fail with the code (or succeed for `ok`).
fn diagTest(xlc: *String, root: *String, dir: *String, fields: *Vec<String>) -> bool {
    local name: *String = fields.get(1)
    local want: *String = fields.get(3)
    local source: String = sourceOf(dir, name)
    local build: Command = compiler(xlc, root, &source, fields.get(2), "xlang_e2e.diag")
    build.output()
    local diagnostics: String = build.errText.clone()
    diagnostics.append(&build.outText)
    if want.equals("ok") {
        if !build.status.success {
            fail(name, "the build must succeed", &diagnostics)
            return false
        }
    } else if build.status.success || !diagnostics.contains(want.asStr()) {
        fail(name, "the build must fail with the expected code", &diagnostics)
        return false
    }
    println("ok   [diag/{}]", name)
    return true
}

@entry fn main(argc: i32, args: **u8) -> i32 {
    if argc < 4 {
        println("usage: runner <path/to/xlc> <stdlib root> <test/e2e directory> [name-filter]")
        return 2
    }
    local xlc: String = String(fromC(args[1]))
    local root: String = String(fromC(args[2]))
    local dir: String = String(fromC(args[3]))
    local filter: String = argc > 4 ? String(fromC(args[4])) : String()

    local table: String = dir.clone()
    table.append("/tests.txt")
    local lines: Vec<String> = split(fsReadAllString(table.cstr()).asStr(), "\n")
    if lines.length() == 0 {
        println("cannot read the table {}", &table)
        return 2
    }
    local passed: i32 = 0
    local failed: i32 = 0
    for i in 0..lines.length() {
        local line: *String = lines.get(i)
        if line.length() == 0 || line.at(0) == b'#' { continue }
        if filter.length() > 0 && !line.contains(filter.asStr()) { continue }
        local fields: Vec<String> = split(line.asStr(), "|")
        local ok: bool = fields.get(0).equals("diag") ? diagTest(&xlc, &root, &dir, &fields) : runTest(&xlc, &root, &dir, &fields)
        if ok { passed++ } else { failed++ }
    }
    fsRemove(BINARY)
    fsRemove("xlang_e2e.diag")
    println("e2e: {} passed, {} failed", passed, failed)
    return failed > 0 ? 1 : 0
}

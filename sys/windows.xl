// Windows: the NT native API. Windows has no stable system call numbers (they change between builds),
// so the stable boundary is ntdll.dll's `Nt*` exports, which are the system calls themselves; they are
// imported with `@library`. Where the OS offers no stable kernel interface (sockets are in `sock.xl`,
// entropy here) the documented user-mode library is used instead: ws2_32 and bcrypt. No C runtime is involved.
//
// A file "fd" is the kernel handle's low 32 bits (kernel handle values are 32-bit safe). Socket fds are
// told apart by `isSocket` in `sock.xl`, so `sysRead`/`sysWrite`/`sysClose` need no table.
from "sock" import isSocket, socketOf, sockSend, sockRecv, sockClose
from "../encoding/utf16" import fromUtf8, toUtf8, utf8LenOf

define CURRENT_PROCESS = -1
define STATUS_PENDING = 0x103
define STATUS_END_OF_FILE = 0xC0000011
define STATUS_PIPE_BROKEN = 0xC000014B

@library("ntdll") declare fn NtWriteFile(h: i64, event: i64, apc: *void, apcCtx: *void, iosb: *i64, buf: *u8, len: u32, offset: *i64, key: *u32) -> i32
@library("ntdll") declare fn NtReadFile(h: i64, event: i64, apc: *void, apcCtx: *void, iosb: *i64, buf: *u8, len: u32, offset: *i64, key: *u32) -> i32
@library("ntdll") declare fn NtCreateFile(h: *i64, access: u32, attrs: *u64, iosb: *i64, alloc: *i64, fileAttrs: u32, share: u32, disposition: u32, options: u32, ea: *void, eaLen: u32) -> i32
@library("ntdll") declare fn NtClose(h: i64) -> i32
@library("ntdll") declare fn NtQueryInformationFile(h: i64, iosb: *i64, info: *void, len: u32, infoClass: u32) -> i32
@library("ntdll") declare fn NtWaitForSingleObject(h: i64, alertable: u8, timeout: *i64) -> i32
@library("ntdll") declare fn NtTerminateProcess(process: i64, status: i32) -> i32
@library("ntdll") declare fn NtAllocateVirtualMemory(process: i64, base: **void, zeroBits: usize, size: *usize, allocType: u32, protect: u32) -> i32
@library("ntdll") declare fn NtFreeVirtualMemory(process: i64, base: **void, size: *usize, freeType: u32) -> i32
@library("ntdll") declare fn NtYieldExecution() -> i32
@library("ntdll") declare fn RtlDosPathNameToNtPathName_U(dos: *u16, nt: *u64, part: *void, relative: *void) -> u8
@library("ntdll") declare fn RtlFreeUnicodeString(s: *u64)

@library("kernel32") declare fn GetStdHandle(which: i32) -> i64

@library("bcrypt") declare fn BCryptGenRandom(alg: *void, buf: *u8, len: u32, flags: u32) -> i32

global ioStatus: [i64; 2]

/// The handle behind descriptor `fd`: the process's standard handle for 0, 1 and 2, otherwise the descriptor itself.
export fn sysStdHandle(fd: i32) -> i64 {
    if fd == 0 { return GetStdHandle(-10) }
    if fd == 1 { return GetStdHandle(-11) }
    if fd == 2 { return GetStdHandle(-12) }
    return fd as i64
}

/// Waits for a pending synchronous request and returns the final status.
fn finish(h: i64, status: i32, iosb: *i64) -> i32 {
    if status == STATUS_PENDING {
        NtWaitForSingleObject(h, 0, nil)
        return iosb[0] as i32
    }
    return status
}

// Writes to a socket or a file handle. Code that writes only to files (the panic message) calls
// `sysWriteFile` instead, so the socket branch and ws2_32 are not linked into programs that never use sockets
// (plan 24, reachability pruning).
export fn sysWrite(fd: i32, buf: *u8, n: usize) -> isize {
    if isSocket(fd) { return sockSend(fd, buf, n) }
    return sysWriteFile(fd, buf, n)
}

/// Writes to a file handle through NtWriteFile. A socket fd is not valid here.
export fn sysWriteFile(fd: i32, buf: *u8, n: usize) -> isize {
    local h: i64 = sysStdHandle(fd)
    local io: [i64; 2]
    local len: u32 = n as u32
    if n > 1073741824 { len = 1073741824 }
    local st: i32 = finish(h, NtWriteFile(h, 0, nil, nil, &io[0], buf, len, nil, nil), &io[0])
    if st < 0 { return -1 }
    return io[1] as isize
}

export fn sysRead(fd: i32, buf: *u8, n: usize) -> isize {
    if isSocket(fd) { return sockRecv(fd, buf, n) }
    local h: i64 = sysStdHandle(fd)
    local io: [i64; 2]
    local len: u32 = n as u32
    if n > 1073741824 { len = 1073741824 }
    local st: i32 = finish(h, NtReadFile(h, 0, nil, nil, &io[0], buf, len, nil, nil), &io[0])
    if st == (STATUS_END_OF_FILE as i32) || st == (STATUS_PIPE_BROKEN as i32) { return 0 }
    if st < 0 { return -1 }
    return io[1] as isize
}

export fn sysExit(code: i32) {
    NtTerminateProcess(CURRENT_PROCESS as i64, code)
}

export fn sysMap(size: usize) -> *void {
    local base: *void = nil
    local region: usize = size
    // MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE
    local st: i32 = NtAllocateVirtualMemory(CURRENT_PROCESS as i64, &base, 0, &region, 12288, 4)
    if st < 0 { return nil }
    return base
}

export fn sysUnmap(p: *void, size: usize) {
    local base: *void = p
    local region: usize = 0
    NtFreeVirtualMemory(CURRENT_PROCESS as i64, &base, &region, 32768)   // MEM_RELEASE
}

// ---- guarded mapping ----------------------------------------------------------------------------
// VirtualAlloc / VirtualProtect / VirtualFree (memoryapi.h), the documented user-mode virtual memory interface:
//   https://learn.microsoft.com/en-us/windows/win32/api/memoryapi/nf-memoryapi-virtualalloc
//   https://learn.microsoft.com/en-us/windows/win32/api/memoryapi/nf-memoryapi-virtualprotect
//   https://learn.microsoft.com/en-us/windows/win32/api/memoryapi/nf-memoryapi-virtualfree
// The contract is the Linux sysMapGuarded one: the returned pointer is the usable base, a single page *below* it (in the
// lower-address direction, where a downward-growing stack overflows) is inaccessible, and sysUnmapGuarded takes the same
// pointer back. The whole reservation is released at once, so the guard page is protected, not split off.
define MEM_COMMIT_RESERVE = 12288       // MEM_COMMIT | MEM_RESERVE
define MEM_RELEASE_FLAG = 32768         // MEM_RELEASE
define PAGE_READWRITE_PROT = 4          // PAGE_READWRITE
define PAGE_NOACCESS_PROT = 1           // PAGE_NOACCESS
// The size is reserved and committed in one call, the same page count as Linux `sysMap(size + 4096)`: the whole range
// becomes one committed region whose lowest page is then made inaccessible, so `VirtualQuery` still describes it as a
// single region and the single `VirtualFree(MEM_RELEASE)` below releases all of it. (The alternative — reserve
// `size + page`, then commit only `size` — needs two calls and leaves the guard page merely reserved.) See the
// VirtualAlloc remarks on page protection.
@library("kernel32") declare fn VirtualAlloc(base: *void, size: usize, allocType: u32, protect: u32) -> *void
@library("kernel32") declare fn VirtualProtect(base: *void, size: usize, newProtect: u32, oldProtect: *u32) -> i32
@library("kernel32") declare fn VirtualFree(base: *void, size: usize, freeType: u32) -> i32

// SYSTEM_INFO (sysinfoapi.h), in documented field order:
//   union { DWORD dwOemId; struct { WORD wProcessorArchitecture; WORD wReserved; } }  offset 0..4
//   DWORD dwPageSize                         4..8
//   LPVOID lpMinimumApplicationAddress       8..16
//   LPVOID lpMaximumApplicationAddress      16..24
//   DWORD_PTR dwActiveProcessorMask         24..32
//   DWORD dwNumberOfProcessors              32..36
//   DWORD dwProcessorType                   36..40
//   DWORD dwAllocationGranularity           40..44
//   WORD wProcessorLevel                    44..46
//   WORD wProcessorRevision                 46..48  (padded to 8-byte alignment: sizeof = 48)
// dwPageSize is therefore at offset 4; it is read through the offset rather than a struct so the layout stays visible.
define SYSTEM_INFO_SIZE = 48
define SYSTEM_INFO_PAGE_SIZE = 4
// https://learn.microsoft.com/en-us/windows/win32/api/sysinfoapi/nf-sysinfoapi-getsysteminfo
@library("kernel32") declare fn GetSystemInfo(info: *u8)

/// The page size the OS rounds every protection change to (dwPageSize of SYSTEM_INFO; 4096 on x86-64 and arm64 Windows, but
/// read instead of assumed).
fn pageSize() -> usize {
    local buf: [u8; SYSTEM_INFO_SIZE]
    GetSystemInfo(&buf[0])
    local v: *u32 = (&buf[0] as usize + SYSTEM_INFO_PAGE_SIZE) as *u32
    if v[0] == 0 { return 4096 }
    return v[0] as usize
}

/// `size` readable/writable bytes with an inaccessible guard page directly below them; the base, or nil.
export fn sysMapGuarded(size: usize) -> *void {
    local page: usize = pageSize()
    local total: usize = size + page
    local base: *void = VirtualAlloc(nil, total, MEM_COMMIT_RESERVE, PAGE_READWRITE_PROT)
    if base == nil { return nil }
    // The guard page is the lowest page of the region: the usable base is the page after it.
    local guard: *void = base
    local old: u32 = 0
    if VirtualProtect(guard, page, PAGE_NOACCESS_PROT, &old) == 0 {
        VirtualFree(base, 0, MEM_RELEASE_FLAG)
        return nil
    }
    return ((base as usize) + page) as *void
}

/// Releases a region made by sysMapGuarded (`p` is the usable base it returned). MEM_RELEASE needs size 0 and the base of
/// the original reservation, which is one page below `p`.
export fn sysUnmapGuarded(p: *void, size: usize) {
    local page: usize = pageSize()
    VirtualFree(((p as usize) - page) as *void, 0, MEM_RELEASE_FLAG)
}

export fn sysYield() {
    NtYieldExecution()
}

export fn sysThreadId() -> i64 {
    return 0
}

export fn sysWait(addr: *u32, expected: u32) {
    local spins: i32 = 0
    while __builtin_atomicLoad(addr, MemoryOrder.acquire) == expected && spins < 64 {
        spins = spins + 1
    }
}

export fn sysWake(addr: *u32, count: i32) {
}

// Threads need `NtCreateThreadEx` plus a futex-like wait (WaitOnAddress); not done yet, the scheduler
// stays on one thread like macOS (see xlang-docs/known-limitations.md).
export fn sysThreadCreate(entry: fn(*void), arg: *void, stack: *void, size: usize, ctid: *u32) -> i64 {
    return -1
}

export fn sysThreadRelease(stack: *void, size: usize) {
    sysUnmap(stack, size)
}

// ---- readiness polling: WSAPoll ------------------------------------------------------------------
// WSAPoll reports readiness of sockets only (https://learn.microsoft.com/en-us/windows/win32/api/winsock2/nf-winsock2-wsapoll).
// It is the readiness backend; IOCP is a completion model and needs a different API, so it is not used here.
// Constants and layout from winsock2.h (public header copy: https://raw.githubusercontent.com/wine-mirror/wine/master/include/winsock2.h):
//   POLLERR 0x0001, POLLHUP 0x0002, POLLNVAL 0x0004, POLLRDNORM 0x0100, POLLRDBAND 0x0200, POLLWRNORM 0x0010.
//   POLLIN = POLLRDNORM|POLLRDBAND = 0x0300, POLLOUT = POLLWRNORM = 0x0010.
// WSAPOLLFD = { SOCKET fd (8 bytes); SHORT events (offset 8); SHORT revents (offset 10) } = 16 bytes with padding.
define WSA_POLL_IN = 768          // 0x0300
define WSA_POLL_OUT = 16          // 0x0010
define WSA_POLLFD_SIZE = 16
define WATCH_CAP = 256            // watches held by the process, shared by every poll set

@library("ws2_32") declare fn WSAPoll(fds: *u8, n: u32, timeout: i32) -> i32

/// One interest: a socket watched by poll set `owner`. `used` false means the slot is free.
struct PollWatch {
    owner: i32
    sock: u64
    events: i16
    token: usize
    used: bool
}

global pollWatches: [PollWatch; 256]
global pollOwnerNext: i32

/// A new poll set. Sets are identified by a process-wide counter; `pfd` is that id.
export fn sysPollCreate() -> i32 {
    pollOwnerNext = pollOwnerNext + 1
    return pollOwnerNext
}

/// Adds or updates a one-shot read or write interest in socket `fd` (a tagged socket fd from `sock.xl`).
/// Like epoll's EPOLLONESHOT, the interest is removed when it fires. Returns 0, or -1 for a file handle
/// or when the process-wide table is full.
export fn sysPollWatch(pfd: i32, fd: i32, write: bool, token: usize) -> i32 {
    if !isSocket(fd) { return -1 }
    local sock: u64 = socketOf(fd)
    local ev: i16 = WSA_POLL_IN as i16
    if write { ev = WSA_POLL_OUT as i16 }
    local free: i32 = -1
    local i: usize = 0
    while i < WATCH_CAP {
        if pollWatches[i].used && pollWatches[i].owner == pfd && pollWatches[i].sock == sock {
            pollWatches[i].events = ev
            pollWatches[i].token = token
            return 0
        }
        if !pollWatches[i].used && free < 0 { free = i as i32 }
        i = i + 1
    }
    if free < 0 { return -1 }
    pollWatches[free as usize].owner = pfd
    pollWatches[free as usize].sock = sock
    pollWatches[free as usize].events = ev
    pollWatches[free as usize].token = token
    pollWatches[free as usize].used = true
    return 0
}

/// Waits up to `timeoutMs` (-1 = forever) for the watches of set `pfd` and stores the tokens of the ready
/// ones (at most `max`); returns how many. Fired watches are removed. An empty set returns 0 at once
/// (WSAPoll rejects an empty array), so it does not sleep for `timeoutMs`.
export fn sysPollWait(pfd: i32, tokens: *usize, max: i32, timeoutMs: i32) -> i32 {
    local buf: [u8; 4096]          // WATCH_CAP WSAPOLLFD entries of 16 bytes
    local slotOf: [usize; 256]      // the pollWatches index behind each WSAPOLLFD entry
    local n: usize = 0
    local i: usize = 0
    while i < WATCH_CAP {
        if pollWatches[i].used && pollWatches[i].owner == pfd {
            local base: usize = &buf[0] as usize + n * WSA_POLLFD_SIZE
            local fdp: *u64 = base as *u64
            fdp[0] = pollWatches[i].sock
            local evp: *i16 = (base + 8) as *i16
            evp[0] = pollWatches[i].events
            evp[1] = 0
            slotOf[n] = i
            n = n + 1
        }
        i = i + 1
    }
    if n == 0 { return 0 }
    local r: i32 = WSAPoll(&buf[0], n as u32, timeoutMs)
    if r <= 0 { return 0 }
    local out: i32 = 0
    local k: usize = 0
    while k < n && out < max {
        local revents: *i16 = (&buf[0] as usize + k * WSA_POLLFD_SIZE + 10) as *i16
        if revents[0] != 0 {
            local w: usize = slotOf[k]
            tokens[out as usize] = pollWatches[w].token
            pollWatches[w].used = false
            out = out + 1
        }
        k = k + 1
    }
    return out
}

export fn sysPipe(fds: *i32, nonblocking: bool) -> i32 {
    return -1
}

// ---- files ---------------------------------------------------------------------------------------

/// UTF-8 -> UTF-16 (an invalid byte becomes U+FFFD), `/` becomes `\`. false if it does not fit in `cap` units with its NUL
/// (a UTF-8 byte never needs more than one unit, so `cap > bytes` always fits).
fn widen(path: *u8, out: *u16, cap: usize) -> bool {
    local n: usize = 0
    while path[n] != 0 { n = n + 1 }
    if n + 1 > cap { return false }
    local units: usize = fromUtf8(path, n, out, cap, true)
    for i in 0..units {
        if out[i] == 47 { out[i] = 92 }
    }
    return true
}

// Directories and the console, through kernel32 (the NT file calls above have no simple directory create or rename).
@library("kernel32") declare fn CreateDirectoryW(path: *u16, security: *void) -> i32
@library("kernel32") declare fn RemoveDirectoryW(path: *u16) -> i32
@library("kernel32") declare fn DeleteFileW(path: *u16) -> i32
@library("kernel32") declare fn MoveFileExW(src: *u16, dst: *u16, flags: u32) -> i32
@library("kernel32") declare fn GetCurrentDirectoryW(cap: u32, buf: *u16) -> u32
@library("kernel32") declare fn GetConsoleMode(h: i64, mode: *u32) -> i32

/// Creates a directory; 0 on success, -1 on failure (also when it exists).
export fn sysMkdir(path: *u8) -> i32 {
    local wide: [u16; 520]
    if !widen(path, &wide[0], 520) { return -1 }
    return CreateDirectoryW(&wide[0], nil) != 0 ? 0 : -1
}

/// Removes an empty directory; 0 on success.
export fn sysRmdir(path: *u8) -> i32 {
    local wide: [u16; 520]
    if !widen(path, &wide[0], 520) { return -1 }
    return RemoveDirectoryW(&wide[0]) != 0 ? 0 : -1
}

/// Renames `src` to `dst`, replacing an existing file (`MOVEFILE_REPLACE_EXISTING`); 0 on success.
export fn sysRename(src: *u8, dst: *u8) -> i32 {
    local a: [u16; 520]
    local b: [u16; 520]
    if !widen(src, &a[0], 520) || !widen(dst, &b[0], 520) { return -1 }
    return MoveFileExW(&a[0], &b[0], 1) != 0 ? 0 : -1
}

// Attributes, times and symbolic links through kernel32: Windows has no permission bits, so `sysChmod` maps the write bits to the
// read-only attribute, and a symbolic link needs a privilege (or Developer Mode, see SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE).
@library("kernel32") declare fn GetFileAttributesW(path: *u16) -> u32
@library("kernel32") declare fn SetFileAttributesW(path: *u16, attrs: u32) -> i32
@library("kernel32") declare fn CreateFileW(path: *u16, access: u32, share: u32, security: *void, disposition: u32, flags: u32, template: i64) -> i64
@library("kernel32") declare fn SetFileTime(h: i64, created: *u64, accessed: *u64, written: *u64) -> i32
@library("kernel32") declare fn CreateSymbolicLinkW(link: *u16, target: *u16, flags: u32) -> u8
@library("kernel32") declare fn DeviceIoControl(h: i64, code: u32, inBuf: *void, inSize: u32, outBuf: *void, outSize: u32, returned: *u32, overlapped: *void) -> i32

define INVALID_ATTRIBUTES = 0xFFFFFFFF
define ATTRIBUTE_READONLY = 1
define ATTRIBUTE_DIRECTORY = 16
define ATTRIBUTE_NORMAL = 128                // valid only alone
define OPEN_EXISTING = 3
define SHARE_ALL = 7
define FILE_FLAGS_REPARSE_BACKUP = 35651584  // FILE_FLAG_OPEN_REPARSE_POINT 0x200000 | FILE_FLAG_BACKUP_SEMANTICS 0x2000000 (opens a link itself, and a directory)
define TICKS_PER_SECOND = 10000000
define SECONDS_1601_TO_1970 = 11644473600

/// Sets or clears the read-only attribute: it is set when `mode` has no write bit (0222) and cleared otherwise; the other bits of a
/// POSIX mode have no meaning here. 0 on success, -1 on failure.
export fn sysChmod(path: *u8, mode: u32) -> i32 {
    local wide: [u16; 520]
    if !widen(path, &wide[0], 520) { return -1 }
    local attrs: u32 = GetFileAttributesW(&wide[0])
    if attrs == INVALID_ATTRIBUTES { return -1 }
    attrs &= INVALID_ATTRIBUTES ^ ATTRIBUTE_NORMAL
    attrs = (mode & 146) == 0 ? attrs | ATTRIBUTE_READONLY : attrs & (INVALID_ATTRIBUTES ^ ATTRIBUTE_READONLY)
    return SetFileAttributesW(&wide[0], attrs == 0 ? ATTRIBUTE_NORMAL : attrs) != 0 ? 0 : -1
}

/// Sets the access and modification times of a file or directory in whole seconds since 1970 (`SetFileTime`; FILETIME counts
/// 100 ns ticks since 1601); 0 on success, -1 on failure.
export fn sysSetTimes(path: *u8, accessSec: i64, modifySec: i64) -> i32 {
    local wide: [u16; 520]
    if !widen(path, &wide[0], 520) { return -1 }
    local h: i64 = CreateFileW(&wide[0], 256, SHARE_ALL, nil, OPEN_EXISTING, 33554432, 0)   // FILE_WRITE_ATTRIBUTES, BACKUP_SEMANTICS
    if h == -1 { return -1 }
    defer NtClose(h)
    local accessed: u64 = ((accessSec + SECONDS_1601_TO_1970) as u64) * TICKS_PER_SECOND
    local written: u64 = ((modifySec + SECONDS_1601_TO_1970) as u64) * TICKS_PER_SECOND
    return SetFileTime(h, nil, &accessed, &written) != 0 ? 0 : -1
}

/// True when the link target `target` (relative to the link's directory unless absolute) names a directory: the kind of a symbolic
/// link on Windows is fixed when it is created.
fn pointsToDirectory(target: *u16, link: *u16) -> bool {
    local full: [u16; 1040]
    local at: i32 = 0
    if target[0] != 92 && !(target[0] != 0 && target[1] == 58) {
        for i in 0..520 {
            if link[i] == 0 { break }
            if link[i] == 92 { at = i + 1 }
        }
        for i in 0..at { full[i] = link[i] }
    }
    for i in 0..520 {
        full[at + i] = target[i]
        if target[i] == 0 { break }
    }
    local attrs: u32 = GetFileAttributesW(&full[0])
    return attrs != INVALID_ATTRIBUTES && (attrs & ATTRIBUTE_DIRECTORY) != 0
}

/// Creates the symbolic link `linkPath` to `target` (a file link, or a directory link when the target is a directory now);
/// 0 on success, -1 on failure, which includes a missing privilege (ERROR_PRIVILEGE_NOT_HELD).
export fn sysSymlink(target: *u8, linkPath: *u8) -> i32 {
    local to: [u16; 520]
    local link: [u16; 520]
    if !widen(target, &to[0], 520) || !widen(linkPath, &link[0], 520) { return -1 }
    // SYMBOLIC_LINK_FLAG_DIRECTORY 1, SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE 2
    local flags: u32 = pointsToDirectory(&to[0], &link[0]) ? 3 : 2
    return CreateSymbolicLinkW(&link[0], &to[0], flags) != 0 ? 0 : -1
}

fn le16(p: *u8, at: usize) -> usize {
    return (p[at] as usize) | (p[at + 1] as usize) << 8
}

/// Writes the target text of the symbolic link `path` as UTF-8 (not NUL terminated) into `buf` and returns its length; -1 when `path`
/// is not a symbolic link or the text does not fit in `cap`. The text keeps the `\` separators Windows stores.
/// `FSCTL_GET_REPARSE_POINT` fills a REPARSE_DATA_BUFFER (MS-FSCC 2.1.2.4): ReparseTag u32 at 0 (IO_REPARSE_TAG_SYMLINK 0xA000000C),
/// then SubstituteNameOffset/Length u16 at 8/10, PrintNameOffset/Length u16 at 12/14, Flags u32 at 16, and the UTF-16 PathBuffer at 20.
export fn sysReadlink(path: *u8, buf: *u8, cap: usize) -> i64 {
    local wide: [u16; 520]
    if !widen(path, &wide[0], 520) { return -1 }
    local h: i64 = CreateFileW(&wide[0], 128, SHARE_ALL, nil, OPEN_EXISTING, FILE_FLAGS_REPARSE_BACKUP, 0)   // FILE_READ_ATTRIBUTES
    if h == -1 { return -1 }
    defer NtClose(h)
    local data: [u8; 4096]
    local got: u32 = 0
    if DeviceIoControl(h, 589992, nil, 0, &data[0] as *void, 4096, &got, nil) == 0 { return -1 }   // FSCTL_GET_REPARSE_POINT 0x900A8
    if data[3] != 0xA0 || data[0] != 0x0C || data[1] != 0 || data[2] != 0 { return -1 }
    // The print name is the user-facing text; some links only have the substitute name, whose `\??\` prefix is dropped.
    local printLen: usize = le16(&data[0], 14)
    local start: usize = 20 + le16(&data[0], printLen > 0 ? 12 : 8)
    local units: usize = (printLen > 0 ? printLen : le16(&data[0], 10)) / 2
    if printLen == 0 && units >= 4 && le16(&data[0], start) == 92 && le16(&data[0], start + 2) == 63 {
        start += 8
        units -= 4
    }
    if units == 0 || units > 520 || start + 2 * units > 4096 { return -1 }
    for i in 0..units { wide[i] = le16(&data[0], start + 2 * i) as u16 }
    if utf8LenOf(&wide[0], units, 3 * 520, false) + 1 > cap { return -1 }
    return toUtf8(&wide[0], units, buf, cap, true) as i64
}

/// Writes the current directory as UTF-8 (NUL terminated) into `buf` and returns its length without the NUL, or -1 when `cap` is too small.
export fn sysGetcwd(buf: *u8, cap: usize) -> i64 {
    local wide: [u16; 520]
    local units: u32 = GetCurrentDirectoryW(520, &wide[0])
    if units == 0 || units >= 520 { return -1 }
    // The conversion keeps a NUL slot: it stops short when the UTF-8 form does not fit, which is the failure case.
    local need: usize = utf8LenOf(&wide[0], units as usize, 3 * 520, false)
    if need + 1 > cap { return -1 }
    return toUtf8(&wide[0], units as usize, buf, cap, true) as i64
}

/// True when descriptor `fd` is a console (`GetConsoleMode` succeeds on a console handle, fails on a file or pipe).
export fn sysIsTerminal(fd: i32) -> bool {
    local mode: u32 = 0
    return GetConsoleMode(sysStdHandle(fd), &mode) != 0
}

/// NtCreateFile on a DOS path. `access`/`disposition`/`options` as in the NT API; -1 on failure.
fn createFile(path: *u8, access: u32, disposition: u32, options: u32) -> i32 {
    local wide: [u16; 520]
    if !widen(path, &wide[0], 520) { return -1 }
    local name: [u64; 2]
    if RtlDosPathNameToNtPathName_U(&wide[0], &name[0], nil, nil) == 0 { return -1 }
    local oa: [u64; 6]
    oa[0] = 48
    oa[1] = 0
    oa[2] = &name[0] as u64
    oa[3] = 64                  // OBJ_CASE_INSENSITIVE
    oa[4] = 0
    oa[5] = 0
    local h: i64 = 0
    local io: [i64; 2]
    // share read|write|delete, FILE_ATTRIBUTE_NORMAL
    local st: i32 = NtCreateFile(&h, access, &oa[0], &io[0], nil, 128, 7, disposition, options, nil, 0)
    RtlFreeUnicodeString(&name[0])
    if st < 0 { return -1 }
    return h as i32
}

// FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE
define FILE_IO_OPTIONS = 96

export fn sysOpenRead(path: *u8) -> i32 {
    // GENERIC_READ | SYNCHRONIZE, FILE_OPEN
    return createFile(path, 0x80100000, 1, FILE_IO_OPTIONS)
}

export fn sysOpenWrite(path: *u8, append: bool) -> i32 {
    if append {
        // FILE_APPEND_DATA | SYNCHRONIZE, FILE_OPEN_IF: writes go to the end of the file
        return createFile(path, 0x100004, 3, FILE_IO_OPTIONS)
    }
    // GENERIC_WRITE | SYNCHRONIZE, FILE_OVERWRITE_IF
    return createFile(path, 0x40100000, 5, FILE_IO_OPTIONS)
}

export fn sysClose(fd: i32) -> i32 {
    if isSocket(fd) { return sockClose(fd) }
    if NtClose(fd as i64) < 0 { return -1 }
    return 0
}

/// Deletes a file, or a symbolic link itself: `DeleteFileW` never follows a link (a link to a directory is not a file, so it fails
/// and `sysRmdir` removes it). `NtDeleteFile` would follow the link and delete the target.
export fn sysUnlink(path: *u8) -> i32 {
    local wide: [u16; 520]
    if !widen(path, &wide[0], 520) { return -1 }
    return DeleteFileW(&wide[0]) != 0 ? 0 : -1
}

/// Metadata of `path` (a file or a directory) into `out[0..3]`: FileAttributes, EndOfFile in bytes, LastWriteTime in 100 ns ticks
/// since 1601 (MS-FSCC 2.4.7 `FileBasicInformation` class 4 and 2.4.41 `FileStandardInformation` class 5). False when it cannot be opened.
export fn sysFileInfo(path: *u8, out: *i64) -> bool {
    // FILE_READ_ATTRIBUTES | SYNCHRONIZE, FILE_OPEN, FILE_SYNCHRONOUS_IO_NONALERT (directories allowed)
    local fd: i32 = createFile(path, 0x100080, 1, 32)
    if fd < 0 { return false }
    defer NtClose(fd as i64)
    local basic: [i64; 5]
    local standard: [i64; 3]
    local io: [i64; 2]
    if NtQueryInformationFile(fd as i64, &io[0], &basic[0] as *void, 40, 4) < 0 { return false }
    if NtQueryInformationFile(fd as i64, &io[0], &standard[0] as *void, 24, 5) < 0 { return false }
    out[0] = basic[4] & 0xffffffff
    out[1] = standard[1]
    out[2] = basic[2]
    return true
}

export fn sysFileSize(fd: i32) -> i64 {
    local info: [i64; 3]        // FILE_STANDARD_INFORMATION: AllocationSize, EndOfFile, ...
    local io: [i64; 2]
    if NtQueryInformationFile(fd as i64, &io[0], &info[0] as *void, 24, 5) < 0 { return -1 }
    return info[1]
}

// ---- entropy and wall clock --------------------------------------------------------------------

/// Fills `buf[0..n]` from the system-preferred CNG RNG (BCRYPT_USE_SYSTEM_PREFERRED_RNG).
export fn sysRandom(buf: *u8, n: usize) -> bool {
    local done: usize = 0
    while done < n {
        local chunk: usize = n - done
        if chunk > 65536 { chunk = 65536 }
        if BCryptGenRandom(nil, &buf[done], chunk as u32, 2) < 0 { return false }
        done = done + chunk
    }
    return true
}

/// Seconds since 1970-01-01 UTC, read from KUSER_SHARED_DATA.SystemTime (the read-only page the
/// kernel maps at 0x7FFE0000 in every process; no call needed). 100 ns units since 1601.
export fn sysClockSeconds() -> i64 {
    local t: *u32 = 2147352596 as *u32            // 0x7FFE0014
    local lo: u32 = 0
    local hi1: i32 = 0
    local hi2: i32 = 0
    local tries: i32 = 0
    while tries < 8 {
        hi1 = t[1] as i32
        lo = t[0]
        hi2 = t[2] as i32
        if hi1 == hi2 {
            local ticks: i64 = ((hi1 as i64) * 4294967296) + (lo as i64)
            return ticks / 10000000 - 11644473600
        }
        tries = tries + 1
    }
    return -1
}

/// Nanoseconds since 1970-01-01 UTC with 100 ns resolution (the same KUSER_SHARED_DATA.SystemTime read; 100 ns units since 1601,
/// 11644473600 seconds before the Unix epoch); negative on failure.
export fn sysClockNanos() -> i64 {
    local t: *u32 = 2147352596 as *u32            // 0x7FFE0014
    for _ in 0..8 {
        local hi: i64 = t[1] as i32 as i64
        local lo: i64 = t[0] as i64
        if hi == (t[2] as i32 as i64) { return (hi * 4294967296 + lo - 116444736000000000) * 100 }
    }
    return -1
}

// ---- memory and environment (kernel32; Microsoft Learn: GlobalMemoryStatusEx, GetEnvironmentVariableW) ---------------------

/// MEMORYSTATUSEX (memoryapi.h): dwLength u32 at 0 (set to 64), dwMemoryLoad u32 at 4, ullTotalPhys u64 at 8.
@library("kernel32") declare fn GlobalMemoryStatusEx(buf: *void) -> i32

/// The installed physical memory in bytes, or -1.
export fn sysMemoryTotal() -> i64 {
    local buf: [u8; 64]
    buf[0] = 64
    if GlobalMemoryStatusEx(&buf[0] as *void) == 0 { return -1 }
    local total: u64 = 0
    local k: usize = 0
    while k < 8 {
        total = total | ((buf[8 + k] as u64) << ((k * 8) as u64))
        k = k + 1
    }
    return total as i64
}

/// GetEnvironmentVariableW: the length of the value (without the terminating NUL) when it fits `size` UTF-16 units, the length
/// needed when it does not, or 0 when the variable is not set.
@library("kernel32") declare fn GetEnvironmentVariableW(name: *u16, buf: *u16, size: u32) -> u32

export fn sysGetEnvW(name: *u16, buf: *u16, size: u32) -> u32 {
    return GetEnvironmentVariableW(name, buf, size)
}

// std/sys/env: the environment of the process. Linux: /proc/self/environ holds the environment the process started with
// (NUL-separated NAME=value pairs; proc(5)). macOS: getenv from libSystem (the process environment is reached through the
// dynamic linker's environ, which the library hides). Windows: not implemented (GetEnvironmentVariableW is planned).
#if os == "linux"

from "linux" import sysOpenRead, sysRead, sysClose

/// The value of environment variable `name` (NUL terminated) copied into `out` (capacity `cap`); returns its length, or -1 when
/// the variable is not set or does not fit.
export fn envGet(name: *u8, out: *u8, cap: usize) -> isize {
    local nlen: usize = 0
    while name[nlen] != 0 { nlen = nlen + 1 }
    local fd: i32 = sysOpenRead("/proc/self/environ")
    if fd < 0 { return -1 }
    local buf: [u8; 65536]
    local n: usize = 0
    while n < 65536 {
        local got: isize = sysRead(fd, &buf[n], 65536 - n)
        if got <= 0 { break }
        n = n + (got as usize)
    }
    sysClose(fd)
    local at: usize = 0
    while at < n {
        local end: usize = at
        while end < n && buf[end] != 0 { end = end + 1 }
        if end - at > nlen && buf[at + nlen] == 61 {
            local same: bool = true
            local i: usize = 0
            while i < nlen {
                if buf[at + i] != name[i] { same = false }
                i = i + 1
            }
            if same {
                local len: usize = end - at - nlen - 1
                if len >= cap { return -1 }
                local k: usize = 0
                while k < len {
                    out[k] = buf[at + nlen + 1 + k]
                    k = k + 1
                }
                out[len] = 0
                return len as isize
            }
        }
        at = end + 1
    }
    return -1
}

#elif os == "macos"

@library("System") declare fn getenv(name: *u8) -> *u8

/// The value of environment variable `name` copied into `out` (capacity `cap`); its length, or -1 when unset or too long.
export fn envGet(name: *u8, out: *u8, cap: usize) -> isize {
    local v: *u8 = getenv(name)
    if v == nil { return -1 }
    local len: usize = 0
    while v[len] != 0 { len = len + 1 }
    if len >= cap { return -1 }
    local k: usize = 0
    while k < len {
        out[k] = v[k]
        k = k + 1
    }
    out[len] = 0
    return len as isize
}

@library("System") declare fn _NSGetEnviron() -> ***u8

/// The whole environment of this process as `NAME=value` C strings ending with nil. A shared library has no `environ` symbol of its
/// own, so libSystem hands out its address (https://developer.apple.com/library/archive/documentation/System/Conceptual/ManPages_iPhoneOS/man7/environ.7.html).
export fn envEntries() -> **u8 {
    return *_NSGetEnviron()
}

#elif os == "windows"

from "windows" import sysGetEnvW

@library("kernel32") declare fn GetEnvironmentStringsW() -> *u16
@library("kernel32") declare fn FreeEnvironmentStringsW(block: *u16) -> i32

/// The whole environment as a UTF-16 block: `NAME=value` entries, each NUL-terminated, then one more NUL. Release it with `envBlockFree`.
/// https://learn.microsoft.com/en-us/windows/win32/api/processenv/nf-processenv-getenvironmentstringsw
export fn envBlock() -> *u16 {
    return GetEnvironmentStringsW()
}

export fn envBlockFree(block: *u16) {
    FreeEnvironmentStringsW(block)
}

// GetEnvironmentVariableW works on UTF-16: the ASCII name is widened, and the ASCII bytes of the value are taken from the low bytes.
export fn envGet(name: *u8, out: *u8, cap: usize) -> isize {
    local wname: [u16; 256]
    local k: usize = 0
    while name[k] != 0 && k + 1 < 256 {
        wname[k] = name[k] as u16
        k = k + 1
    }
    wname[k] = 0
    local wbuf: [u16; 1024]
    local need: u32 = sysGetEnvW(&wname[0], &wbuf[0], 1024)
    if need == 0 || need >= 1024 || (need as usize) >= cap { return -1 }
    local i: usize = 0
    while i < (need as usize) {
        out[i] = (wbuf[i] & 255) as u8
        i = i + 1
    }
    out[i] = 0
    return need as isize
}

#else

export fn envGet(name: *u8, out: *u8, cap: usize) -> isize {
    return -1
}

#endif

// std/os/env: the environment of the process as `NAME=value` entries (`Vec<String>`), and lookups and updates on such a list.
// The list a child process starts with is built from it (`std/os/process`).
//
// Linux has no libc `environ` here: /proc/self/environ holds the environment the process started with (proc(5)); nothing in the
// language changes the environment of a running process, so it is also the current one. macOS reads the array libSystem keeps, Windows
// the block of GetEnvironmentStringsW, converted from UTF-16 to UTF-8. A Windows name is compared without regard to case, a Unix name exactly.
from "../str/string" import String, split
from "../collections/vec" import Vec
from "../collections/option" import Option

/// Where the name of `entry` ends: before the first `=`. An entry may start with `=` (Windows keeps per-drive directories as `=C:=C:\`),
/// which belongs to the name.
fn nameEnd(entry: *String) -> usize {
    for i in 1..entry.length() {
        if entry.at(i) == b'=' { return i }
    }
    return entry.length()
}

fn sameName(entry: *String, name: *String) -> bool {
    local head: String = entry.slice(0, nameEnd(entry))
#if os == "windows"
    return head.equalsIgnoreCase(name.asStr())
#else
    return head.equals(name)
#endif
}

#if os == "linux"

from "../sys" import sysOpenRead
from "../io/stream" import Stream

/// The environment of this process, one `NAME=value` entry per element.
export fn list() -> Vec<String> {
    local all: Vec<String> = Vec<String>()
    local fd: i32 = sysOpenRead("/proc/self/environ")
    if fd < 0 { return all }
    local file: Stream = Stream(fd, true)
    local raw: String = file.readAll()
    local parts: Vec<String> = split(raw.asStr(), "\0")
    for i in 0..parts.length() {
        if parts.get(i).length() > 0 { all.push(parts.get(i).clone()) }
    }
    return all
}

#elif os == "macos"

from "../sys" import envEntries
from "../str/str" import fromC

/// The environment of this process, one `NAME=value` entry per element.
export fn list() -> Vec<String> {
    local all: Vec<String> = Vec<String>()
    local entries: **u8 = envEntries()
    for local i := 0; entries[i] != nil; i++ {
        all.push(String(fromC(entries[i])))
    }
    return all
}

#elif os == "windows"

from "../sys" import envBlock, envBlockFree
from "../encoding/utf16" import toUtf8

/// The environment of this process, one `NAME=value` entry per element.
export fn list() -> Vec<String> {
    local all: Vec<String> = Vec<String>()
    local block: *u16 = envBlock()
    if block == nil { return all }
    local at: usize = 0
    while block[at] != 0 {
        local n: usize = 0
        while block[at + n] != 0 { n++ }
        local utf8: String = String(n * 3, 0)           // UTF-16 to UTF-8 grows by at most 3 bytes per unit
        utf8.len = toUtf8(&block[at], n, utf8.ptr, n * 3, true)
        all.push(utf8)
        at += n + 1
    }
    envBlockFree(block)
    return all
}

#endif

/// The value of `name` in the entry list `env`, or None when it has no such entry.
export fn lookup(env: *Vec<String>, name: *String) -> Option<String> {
    for i in 0..env.length() {
        local entry: *String = env.get(i)
        if sameName(entry, name) { return Option.Some(entry.slice(nameEnd(entry) + 1, entry.length() - nameEnd(entry) - 1)) }
    }
    return Option.None
}

/// The value of the variable `name` of this process, or None when it is not set.
export fn get(name: *String) -> Option<String> {
    local all: Vec<String> = list()
    return lookup(&all, name)
}

/// Sets `name` to `value` in `env`: an entry of the same name is replaced, otherwise one is added.
export fn set(env: *Vec<String>, name: *String, value: *String) {
    local entry: String = name.clone()
    entry.push(b'=')
    entry.append(value)
    for i in 0..env.length() {
        if sameName(env.get(i), name) {
            env.set(i, entry)
            return
        }
    }
    env.push(entry)
}

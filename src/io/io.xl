// std/io/io: the print family. Every function writes straight to its fd through an FmtSink and makes
// no allocator calls. `print` writes without a newline, `println` adds one "\n" after the text, and
// `printEndl()` writes only "\n". The text rules (`{}`, `{{`, `}}`) live in std/str/fmt.
from "../str/fmt" import FmtSink, FmtFd
from "../str/fmtspec" import fmtWrite, fmtEmit
from "../str/string" import String
from "../sys" import sysRead, sysWrite

// ---- stdout ---------------------------------------------------------------------------------

export fn print(s: str) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, s)
}

export fn print(p: *u8) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, p)
}

export fn print(v: i64) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, v)
}

export fn print(v: u64) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, v)
}

export fn print(v: f64) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, v)
}

export fn print(b: bool) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, b)
}

export fn print(s: *String) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, s)
}

/// `print("x = {}, y = {}", x, y)`: `{}` takes the next argument, `{{` and `}}` are braces.
export fn print(fmt: str, ..args) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtEmit(&sink, fmt, ..args)
}

export fn println(s: str) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, s)
    sink.writeBytes("\n")
}

export fn println(p: *u8) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, p)
    sink.writeBytes("\n")
}

export fn println(v: i64) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, v)
    sink.writeBytes("\n")
}

export fn println(v: u64) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, v)
    sink.writeBytes("\n")
}

export fn println(v: f64) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, v)
    sink.writeBytes("\n")
}

export fn println(b: bool) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, b)
    sink.writeBytes("\n")
}

export fn println(s: *String) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtWrite(&sink, s)
    sink.writeBytes("\n")
}

/// `println("x = {}", x)`: the same as `print` followed by one "\n".
export fn println(fmt: str, ..args) {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    fmtEmit(&sink, fmt, ..args)
    sink.writeBytes("\n")
}

/// Writes only "\n"; the same as `print("\n")`.
export fn printEndl() {
    local sink: FmtSink = FmtSink(FmtFd,1, nil, 0, nil)
    sink.writeBytes("\n")
}


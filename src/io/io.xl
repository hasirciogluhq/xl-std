// ---- raw descriptor I/O ---------------------------------------------------------------------

/// Reads up to `n` bytes from `fd` into `buf`; blocks in the OS call. Returns the count or -errno.
export fn ioRead(fd: i32, buf: *u8, n: usize) -> isize {
    return sysRead(fd, buf, n)
}

/// Writes up to `n` bytes of `buf` to `fd`; blocks in the OS call. Returns the count or -errno.
export fn ioWrite(fd: i32, buf: *u8, n: usize) -> isize {
    return sysWrite(fd, buf, n)
}

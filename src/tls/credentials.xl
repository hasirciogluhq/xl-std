// std/tls/credentials: the server's certificate chain and private key, loaded once from PEM and shared by every
// accepted connection, with the protocol versions the server accepts.
from "../sys" import sysMap, sysUnmap
from "../io/fs" import fsReadAll
from "../encoding/pem" import pemNext
from "../crypto/ct" import secureZero
from "../crypto/x509/privkey" import PrivKey, privKeyParsePem
from "../crypto/x509/x509" import Cert, x509Parse
from "conn" import TLS_OK, TLS_ERR_MEMORY, TLS_ERR_CREDENTIALS, TLS_1_2, TLS_1_3
from "wire" import emit16, emit24, emitBytes

define CRED_CAP = 65536
define CRED_LIST_MAX = 60000              // the Certificate message must fit one handshake buffer with its headers

export struct TlsCredentials {
    list: *u8                // TLS 1.3 certificate_list entries: [u24 length, DER, u16 0] per certificate
    listLen: usize
    count: usize             // certificates in the list
    key: PrivKey
    minVersion: u16          // TLS_1_2 by default; set to TLS_1_3 to refuse TLS 1.2 clients
    maxVersion: u16          // TLS_1_3 by default; set to TLS_1_2 to serve TLS 1.2 only
}

fn loadCredentials(cr: *TlsCredentials, certPem: *u8, certLen: usize, keyPem: *u8, keyLen: usize) -> i32 {
    local der: [u8; 8192]
    local pos: usize = 0
    while true {
        local dn = pemNext(certPem, certLen, &pos, "CERTIFICATE", &der[0], 8192)
        if dn == 0 { break }
        if cr.listLen + dn + 5 > CRED_LIST_MAX { return TLS_ERR_CREDENTIALS }
        if cr.count == 0 {
            local leaf: Cert
            if !x509Parse(&leaf, &der[0], dn) { return TLS_ERR_CREDENTIALS }
            cr.key.keyType = leaf.keyType         // checked against the key below
        }
        emit24(cr.list, &cr.listLen, dn)
        emitBytes(cr.list, &cr.listLen, &der[0], dn)
        emit16(cr.list, &cr.listLen, 0)
        cr.count++
    }
    if cr.count == 0 { return TLS_ERR_CREDENTIALS }
    local leafType = cr.key.keyType
    if !privKeyParsePem(keyPem, keyLen, &cr.key) || cr.key.keyType != leafType { return TLS_ERR_CREDENTIALS }
    return TLS_OK
}

/// Loads a PEM certificate chain (leaf first) and its PEM private key (PKCS#8, PKCS#1 RSA or SEC1 EC) from memory.
/// The key must match the leaf certificate's key type. The texts are only read. Both TLS 1.2 and 1.3 are accepted
/// until `minVersion` / `maxVersion` are changed.
export fn tlsLoadCredentialsPem(cr: *TlsCredentials, certPem: *u8, certLen: usize, keyPem: *u8, keyLen: usize) -> i32 {
    cr.listLen = 0
    cr.count = 0
    cr.key.keyType = 0
    cr.minVersion = TLS_1_2
    cr.maxVersion = TLS_1_3
    cr.list = sysMap(CRED_CAP) as *u8
    if cr.list == nil { return TLS_ERR_MEMORY }
    local r = loadCredentials(cr, certPem, certLen, keyPem, keyLen)
    if r != TLS_OK { tlsFreeCredentials(cr) }
    return r
}

/// `tlsLoadCredentialsPem` from two files.
export fn tlsLoadCredentials(cr: *TlsCredentials, certPath: *u8, keyPath: *u8) -> i32 {
    local certText = sysMap(CRED_CAP * 2) as *u8
    if certText == nil { return TLS_ERR_MEMORY }
    local keyText = &certText[CRED_CAP]
    local r: i32 = TLS_ERR_CREDENTIALS
    local cn = fsReadAll(certPath, certText, CRED_CAP)
    local kn = fsReadAll(keyPath, keyText, CRED_CAP)
    if cn > 0 && kn > 0 { r = tlsLoadCredentialsPem(cr, certText, cn as usize, keyText, kn as usize) }
    secureZero(certText, CRED_CAP * 2)                        // the buffer held the private key
    sysUnmap(certText as *void, CRED_CAP * 2)
    return r
}

/// Releases the chain buffer and wipes the private key.
export fn tlsFreeCredentials(cr: *TlsCredentials) {
    if cr.list != nil { sysUnmap(cr.list as *void, CRED_CAP) }
    cr.list = nil
    cr.listLen = 0
    cr.count = 0
    secureZero(&cr.key as *u8, sizeOf(PrivKey))
}

// std/crypto/cipher/aesgcm: AES-128-GCM (FIPS 197, NIST SP 800-38D) with a 12-byte nonce and a 16-byte tag, the
// TLS 1.3 mandatory-to-implement AEAD. Table-driven S-box built on first use; the GHASH multiply is
// bitwise. Not constant-time (the S-box lookups are data dependent): intended for a client whose
// peers cannot observe its cache, like the rest of this stdlib's crypto. `ct`/`pt` may alias.
from "aes" import aesEncrypt, aesKeyExpand, aesRounds

fn load64(p: *u8) -> u64 {
    local v: u64 = 0
    local i: usize = 0
    while i < 8 {
        v = (v << 8) | (p[i] as u64)
        i = i + 1
    }
    return v
}

fn store64(p: *u8, v: u64) {
    local i: usize = 0
    while i < 8 {
        p[i] = ((v >> (((7 - i) * 8) as u64)) & 0xff) as u8
        i = i + 1
    }
}

/// GHASH state: `y = (y xor block) * h` in GF(2^128) with the GCM bit order.
struct Ghash {
    hh: u64
    hl: u64
    yh: u64
    yl: u64
}

fn ghashBlock(g: *Ghash, block: *u8) {
    local xh: u64 = g.yh ^ load64(block)
    local xl: u64 = g.yl ^ load64(&block[8])
    local zh: u64 = 0
    local zl: u64 = 0
    local vh: u64 = g.hh
    local vl: u64 = g.hl
    local i: usize = 0
    while i < 128 {
        local bit: u64 = 0
        if i < 64 {
            bit = (xh >> ((63 - i) as u64)) & 1
        } else {
            bit = (xl >> ((127 - i) as u64)) & 1
        }
        if bit != 0 {
            zh = zh ^ vh
            zl = zl ^ vl
        }
        local lsb: u64 = vl & 1
        vl = (vl >> 1) | (vh << 63)
        vh = vh >> 1
        if lsb != 0 { vh = vh ^ 0xe100000000000000 }
        i = i + 1
    }
    g.yh = zh
    g.yl = zl
}

/// Absorbs `n` bytes, zero-padded to a multiple of 16.
fn ghashData(g: *Ghash, data: *u8, n: usize) {
    local block: [u8; 16]
    local at: usize = 0
    while at < n {
        local take: usize = n - at
        if take > 16 { take = 16 }
        local i: usize = 0
        while i < 16 {
            block[i] = 0
            if i < take { block[i] = data[at + i] }
            i = i + 1
        }
        ghashBlock(g, &block[0])
        at = at + 16
    }
}

fn incCounter(ctr: *u8) {
    local i: usize = 15
    local carry: bool = true
    while carry && i >= 12 {
        ctr[i] = ctr[i] + 1
        carry = ctr[i] == 0
        i = i - 1
    }
}

/// CTR keystream starting at counter block `start` (already incremented past J0).
fn ctrXor(rk: *u8, rounds: usize, ctr: *u8, in: *u8, n: usize, out: *u8) {
    local ks: [u8; 16]
    local at: usize = 0
    while at < n {
        aesEncrypt(rk, rounds, ctr, &ks[0])
        incCounter(ctr)
        local take: usize = n - at
        if take > 16 { take = 16 }
        local i: usize = 0
        while i < take {
            out[at + i] = in[at + i] ^ ks[i]
            i = i + 1
        }
        at = at + 16
    }
}

fn tagFor(rk: *u8, rounds: usize, nonce: *u8, aad: *u8, alen: usize, ct: *u8, n: usize, tag: *u8) {
    local zero: [u8; 16]
    local hb: [u8; 16]
    local i: usize = 0
    while i < 16 {
        zero[i] = 0
        i = i + 1
    }
    aesEncrypt(rk, rounds, &zero[0], &hb[0])
    local g: Ghash
    g.hh = load64(&hb[0])
    g.hl = load64(&hb[8])
    g.yh = 0
    g.yl = 0
    ghashData(&g, aad, alen)
    ghashData(&g, ct, n)
    local lens: [u8; 16]
    store64(&lens[0], (alen as u64) * 8)
    store64(&lens[8], (n as u64) * 8)
    ghashBlock(&g, &lens[0])
    // tag = E(K, J0) xor GHASH
    local j0: [u8; 16]
    i = 0
    while i < 12 {
        j0[i] = nonce[i]
        i = i + 1
    }
    j0[12] = 0
    j0[13] = 0
    j0[14] = 0
    j0[15] = 1
    local ej: [u8; 16]
    aesEncrypt(rk, rounds, &j0[0], &ej[0])
    local gb: [u8; 16]
    store64(&gb[0], g.yh)
    store64(&gb[8], g.yl)
    i = 0
    while i < 16 {
        tag[i] = ej[i] ^ gb[i]
        i = i + 1
    }
}

fn startCounter(nonce: *u8, ctr: *u8) {
    local i: usize = 0
    while i < 12 {
        ctr[i] = nonce[i]
        i = i + 1
    }
    ctr[12] = 0
    ctr[13] = 0
    ctr[14] = 0
    ctr[15] = 2          // J0 + 1
}

/// Block cipher check value: `out[0..16] = AES-128(key, in[0..16])` (exported for known-answer tests).
export fn aes128EncryptBlock(key: *u8, in: *u8, out: *u8) {
    local rk: [u8; 176]
    aesKeyExpand(key, 16, &rk[0])
    aesEncrypt(&rk[0], 10, in, out)
}

/// Encrypts `pt[0..n]` into `ct` (may alias) and writes the 16-byte `tag`. `key` is `keyLen` bytes (16, 24 or 32;
/// AES-128, -192 or -256), `nonce` 12 bytes. Panics on any other key length.
export fn aesGcmSeal(key: *u8, keyLen: usize, nonce: *u8, aad: *u8, alen: usize, pt: *u8, n: usize, ct: *u8, tag: *u8) {
    local rounds: usize = aesRounds(keyLen)
    if rounds == 0 { panic("aesGcmSeal: the key must be 16, 24 or 32 bytes") }
    local rk: [u8; 240]
    aesKeyExpand(key, keyLen, &rk[0])
    local ctr: [u8; 16]
    startCounter(nonce, &ctr[0])
    ctrXor(&rk[0], rounds, &ctr[0], pt, n, ct)
    tagFor(&rk[0], rounds, nonce, aad, alen, ct, n, tag)
}

/// Verifies the tag and, only if it matches, decrypts `ct[0..n]` into `pt` (may alias).
export fn aesGcmOpen(key: *u8, keyLen: usize, nonce: *u8, aad: *u8, alen: usize, ct: *u8, n: usize, tag: *u8, pt: *u8) -> bool {
    local rounds: usize = aesRounds(keyLen)
    if rounds == 0 { panic("aesGcmOpen: the key must be 16, 24 or 32 bytes") }
    local rk: [u8; 240]
    aesKeyExpand(key, keyLen, &rk[0])
    local want: [u8; 16]
    tagFor(&rk[0], rounds, nonce, aad, alen, ct, n, &want[0])
    local diff: u8 = 0
    local i: usize = 0
    while i < 16 {
        diff = diff | (want[i] ^ tag[i])
        i = i + 1
    }
    if diff != 0 { return false }
    local ctr: [u8; 16]
    startCounter(nonce, &ctr[0])
    ctrXor(&rk[0], rounds, &ctr[0], ct, n, pt)
    return true
}

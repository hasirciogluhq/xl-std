// std/http/client: an HTTP/1.1 client (RFC 9110 semantics, https://www.rfc-editor.org/rfc/rfc9110, and RFC 9112 messages,
// https://www.rfc-editor.org/rfc/rfc9112) over a Transport (std/http/transport): TCP for http, TLS 1.3 for https.
//
// - `send` returns the whole Response; `stream` hands the body to a sink (a function or closure `(r: *Response, chunk: *String) -> bool`)
//   piece by piece as it arrives, so a body of any size passes through constant memory. The sink sees the status and the headers in
//   `r`; returning false stops the transfer with `HttpError.Aborted`.
// - Body framing follows RFC 9112 section 6.3: no body for HEAD, 1xx, 204 and 304; chunked transfer coding (section 7.1, extensions
//   and trailer fields are read and ignored); Content-Length; otherwise until the server closes. Interim 1xx responses are skipped.
// - Redirects 301, 302, 303, 307 and 308 are followed up to `maxRedirects` (0 returns the 3xx response itself). 303, and 301/302 after
//   a POST, continue as GET without the body or its Content-* fields (RFC 9110 section 15.4). Authorization, Proxy-Authorization and
//   Cookie go only to the origin of the first URL.
// - A connection that fails before a response head arrives (refused, reset, closed early, timed out) is retried `retries` times for
//   the idempotent methods (RFC 9110 section 9.2.2: all but POST and PATCH). Nothing is retried once the head was read.
// - Every request is sent with `Connection: close` on a fresh connection; no Accept-Encoding is sent, so bodies arrive as they are.
from "../str/string" import String
from "../str/fmtspec" import format
from "../collections/result" import Result
from "url" import Url, HttpError, parseUrl, decimal
from "headers" import Headers
from "transport" import Transport, NetConn, Wire
from "util" import hexDigit

define BODY_PIECE = 65536     // the largest piece handed to a sink at once
define MAX_FIELDS = 256       // header fields accepted in one response

/// A request: method, absolute URL, header fields and a body (empty for none).
export class Request {
    method: String
    url: String
    headers: Headers
    body: String

    fn init(self, method: str, url: *String) {
        self.method = String(method)
        self.url = url.clone()
        self.headers = Headers()
        self.body = String()
    }
}

/// A response: status, reason phrase, header fields, the body (filled by `send`, empty after `stream`) and the URL that answered.
export class Response {
    status: i32
    reason: String
    headers: Headers
    body: String
    url: String

    fn init(self) {
        self.status = 0
        self.reason = String()
        self.headers = Headers()
        self.body = String()
        self.url = String()
    }

    /// True for a 2xx status.
    fn ok(self) -> bool {
        return self.status >= 200 && self.status < 300
    }

    fn header(self, name: str) -> String {
        return self.headers.get(name)
    }
}

export class Client {
    timeoutMs: i32        // read timeout of each connection; 0 waits forever
    maxRedirects: i32
    retries: i32          // extra attempts after a connection fails before the response head
    userAgent: String

    fn init(self) {
        self.timeoutMs = 30000
        self.maxRedirects = 10
        self.retries = 2
        self.userAgent = String("xlang-http/1.0")
    }

    fn get(self, url: *String) -> Result<Response, HttpError> {
        local r = Request("GET", url)
        return self.send(&r)
    }

    fn head(self, url: *String) -> Result<Response, HttpError> {
        local r = Request("HEAD", url)
        return self.send(&r)
    }

    fn post(self, url: *String, contentType: str, body: *String) -> Result<Response, HttpError> {
        return self.sendBody("POST", url, contentType, body)
    }

    fn put(self, url: *String, contentType: str, body: *String) -> Result<Response, HttpError> {
        return self.sendBody("PUT", url, contentType, body)
    }

    fn delete(self, url: *String) -> Result<Response, HttpError> {
        local r = Request("DELETE", url)
        return self.send(&r)
    }

    fn sendBody(self, method: str, url: *String, contentType: str, body: *String) -> Result<Response, HttpError> {
        local r = Request(method, url)
        r.headers.set("Content-Type", contentType)
        r.body = body.clone()
        return self.send(&r)
    }

    /// Sends `req` and reads the whole response body into `Response.body`.
    fn send(self, req: *Request) -> Result<Response, HttpError> {
        local net = NetConn()
        return self.sendVia(&net, req)
    }

    /// `send` over the transport `t`.
    fn sendVia(self, t: Transport, req: *Request) -> Result<Response, HttpError> {
        return self.streamVia(t, req, keepBody)
    }

    /// Sends `req` and hands the body to `sink(r, chunk)` as it arrives; the returned Response has an empty body.
    fn stream<F>(self, req: *Request, sink: F) -> Result<Response, HttpError> {
        local net = NetConn()
        return self.streamVia(&net, req, sink)
    }

    /// `stream` over the transport `t`, which is closed when the call returns.
    fn streamVia<F>(self, t: Transport, req: *Request, sink: F) -> Result<Response, HttpError> {
        defer t.close()
        local url = parseUrl(&req.url)?
        local first = url.origin()
        local method = req.method.toUpperAscii()
        local body = req.body.clone()
        local plain = false               // true once a redirect turned the request into a bodiless GET
        local wire = Wire(t)
        for hop in 0..self.maxRedirects + 1 {
            local origin = url.origin()
            local head = requestHead(self, &url, &method, req, &body, origin.equals(&first), plain)?
            local out = Response()
            self.open(&wire, &url, &head, &body, idempotent(&method), &out)?
            local location = out.header("Location")
            if self.maxRedirects > 0 && isRedirect(out.status) && location.length() > 0 {
                if hop == self.maxRedirects { return Result.Err(HttpError.Redirect) }
                switch url.resolve(&location) {
                    case Result.Ok(next) { url = next }
                    case Result.Err(_) { return Result.Err(HttpError.Redirect) }
                }
                if (out.status == 303 && !method.equals("HEAD")) || (out.status <= 302 && method.equals("POST")) {
                    method = String("GET")
                    body.clear()
                    plain = true
                }
                continue
            }
            readBody(&wire, &method, &out, sink)?
            out.url = url.toString()
            return Result.Ok(out)
        }
        return Result.Err(HttpError.Redirect)
    }

    /// Connects, sends the request and reads the response head, retrying an idempotent request whose connection fails first.
    fn open(self, w: *Wire, u: *Url, head: *String, body: *String, retry: bool, out: *Response) -> Result<bool, HttpError> {
        local attempts = retry ? self.retries + 1 : 1
        local last = HttpError.Io
        for i in 0..attempts {
            w.reset()
            switch exchange(w, u, self.timeoutMs, head, body, out) {
                case Result.Ok(done) { return Result.Ok(true) }
                case Result.Err(e) {
                    if e != HttpError.Connect && e != HttpError.Io { return Result.Err(e) }
                    last = e
                }
            }
        }
        return Result.Err(last)
    }
}

fn keepBody(r: *Response, chunk: *String) -> bool {
    r.body.append(chunk)
    return true
}

fn isRedirect(status: i32) -> bool {
    return status == 301 || status == 302 || status == 303 || status == 307 || status == 308
}

fn idempotent(method: *String) -> bool {
    return !method.equals("POST") && !method.equals("PATCH")
}

/// One attempt: connect, write the head and the body, read the response head.
fn exchange(w: *Wire, u: *Url, timeoutMs: i32, head: *String, body: *String, out: *Response) -> Result<bool, HttpError> {
    w.t.connect(u, timeoutMs)?
    if !w.t.write(head) || (body.length() > 0 && !w.t.write(body)) { return Result.Err(HttpError.Io) }
    return readHead(w, out)
}

/// The request line and header block (RFC 9112 sections 3 and 5). Host, Connection and Content-Length are the client's own; a
/// field holding CR or LF would split the message, so it is refused (request smuggling, RFC 9112 section 11.2).
fn requestHead(c: *Client, u: *Url, method: *String, req: *Request, body: *String, trusted: bool, plain: bool) -> Result<String, HttpError> {
    local auth = u.authority()
    local head = format("{} {} HTTP/1.1\r\nHost: {}\r\n", method, &u.target, &auth)
    if !req.headers.has("User-Agent") { head.append(format("User-Agent: {}\r\n", &c.userAgent)) }
    for h in req.headers.items {
        local name = h.name.toLowerAscii()
        if name.equals("host") || name.equals("connection") || name.equals("content-length") { continue }
        if !trusted && (name.equals("authorization") || name.equals("proxy-authorization") || name.equals("cookie")) { continue }
        if plain && name.startsWith("content-") { continue }
        if name.contains(":") || name.contains("\r") || name.contains("\n") || h.value.contains("\r") || h.value.contains("\n") {
            return Result.Err(HttpError.Request)
        }
        head.append(format("{}: {}\r\n", &h.name, &h.value))
    }
    head.append("Connection: close\r\n")
    if body.length() > 0 || method.equals("POST") || method.equals("PUT") || method.equals("PATCH") {
        head.append(format("Content-Length: {}\r\n", body.length() as u64))
    }
    head.append("\r\n")
    return Result.Ok(head)
}

/// Reads the status line and the header fields into `out`, skipping interim 1xx responses (RFC 9110 section 15.2; 101 is final).
fn readHead(w: *Wire, out: *Response) -> Result<bool, HttpError> {
    while true {
        local line = w.line()?
        // `HTTP/1.x SSS reason` (RFC 9112 section 4); the reason phrase may be empty.
        if line.length() < 12 || !line.startsWith("HTTP/1.") || line.at(8) != b' ' { return Result.Err(HttpError.Protocol) }
        local status = decimal(&line.slice(9, 3))
        if status < 100 || (line.length() > 12 && line.at(12) != b' ') { return Result.Err(HttpError.Protocol) }
        out.status = status as i32
        out.reason = line.length() > 13 ? line.slice(13, line.length() - 13) : String()
        out.headers = Headers()
        while true {
            local field = w.line()?
            if field.length() == 0 { break }
            if out.headers.length() >= MAX_FIELDS { return Result.Err(HttpError.TooLarge) }
            local colon = field.find(":")
            if colon <= 0 { return Result.Err(HttpError.Protocol) }
            local name = field.slice(0, colon as usize)
            if name.endsWith(" ") || name.endsWith("\t") { return Result.Err(HttpError.Protocol) }      // section 5.1
            local value = field.slice(colon as usize + 1, field.length() - (colon as usize) - 1).trimStart().trimEnd()
            out.headers.add(name.asStr(), &value)
        }
        if out.status >= 200 || out.status == 101 { return Result.Ok(true) }
    }
    return Result.Err(HttpError.Protocol)
}

fn readBody<F>(w: *Wire, method: *String, out: *Response, sink: F) -> Result<bool, HttpError> {
    if method.equals("HEAD") || out.status < 200 || out.status == 204 || out.status == 304 { return Result.Ok(true) }
    local coding = out.header("Transfer-Encoding").toLowerAscii()
    if coding.endsWith("chunked") { return readChunked(w, out, sink) }
    if coding.length() == 0 && out.headers.has("Content-Length") {
        local n = decimal(&out.header("Content-Length").trimStart().trimEnd())
        if n < 0 { return Result.Err(HttpError.Protocol) }
        return readLength(w, out, n as u64, sink)
    }
    // No length: the body ends when the server closes the connection (RFC 9112 section 6.3 rule 8).
    while true {
        local part = w.next(BODY_PIECE)?
        if part.length() == 0 { return Result.Ok(true) }
        if !sink(out, &part) { return Result.Err(HttpError.Aborted) }
    }
    return Result.Ok(true)
}

/// Exactly `n` bytes of body; fewer before the stream ends is a truncated response.
fn readLength<F>(w: *Wire, out: *Response, n: u64, sink: F) -> Result<bool, HttpError> {
    local left = n
    while left > 0 {
        local part = w.next(left > BODY_PIECE ? BODY_PIECE : left as usize)?
        if part.length() == 0 { return Result.Err(HttpError.Io) }
        left -= part.length() as u64
        if !sink(out, &part) { return Result.Err(HttpError.Aborted) }
    }
    return Result.Ok(true)
}

/// The chunked coding (RFC 9112 section 7.1): `size-in-hex[;ext]` CRLF, the data, CRLF; a zero size ends it, then trailer lines
/// up to an empty one.
fn readChunked<F>(w: *Wire, out: *Response, sink: F) -> Result<bool, HttpError> {
    while true {
        local line = w.line()?
        local size: u64 = 0
        local digits: usize = 0
        for c in line.asStr() {
            local d = hexDigit(c)
            if d < 0 { break }
            if size >> 56 != 0 { return Result.Err(HttpError.Protocol) }
            size = size * 16 + d as u64
            digits++
        }
        if digits == 0 { return Result.Err(HttpError.Protocol) }
        if size == 0 {
            while w.line()?.length() > 0 { }
            return Result.Ok(true)
        }
        readLength(w, out, size, sink)?
        if w.line()?.length() != 0 { return Result.Err(HttpError.Protocol) }
    }
    return Result.Ok(true)
}

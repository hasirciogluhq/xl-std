define HANDLE_FLAG_INHERIT = 1
define EXTENDED_STARTUPINFO_PRESENT = 0x80000
define CREATE_UNICODE_ENVIRONMENT = 0x400
define STARTF_USESTDHANDLES = 0x100
define PROC_THREAD_ATTRIBUTE_HANDLE_LIST = 0x20002
define PROCESS_TERMINATE = 0x1
define PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
define SYNCHRONIZE = 0x100000
define TOKEN_QUERY = 0x8
define TOKEN_ELEVATION_CLASS = 20          // TOKEN_INFORMATION_CLASS: TokenElevation, a TOKEN_ELEVATION { DWORD TokenIsElevated }
define WAIT_OBJECT_0 = 0
define WAIT_TIMEOUT = 0x102
define INFINITE = 0xFFFFFFFF
define COMMAND_CHARS = 32768                // CreateProcessW: lpCommandLine is at most 32,767 characters including the NUL
define KILLED_EXIT_CODE = 1

/// A pipe for a child: `fds[0]` reads, `fds[1]` writes. Neither end is inheritable; `sysSpawn` makes the child's end inheritable
/// for exactly one call (through the handle list), so no other child of this process can get it.
export fn sysSpawnPipe(fds: *i32) -> i32 {
    local r: i64 = 0
    local w: i64 = 0
    if CreatePipe(&r, &w, nil, 0) == 0 { return -1 }
    fds[0] = r as i32
    fds[1] = w as i32
    return 0
}

/// Appends `arg` to the command line `out` at `at` as one CommandLineToArgvW argument and returns the new length, or 0 when it does
/// not fit. Rules: https://learn.microsoft.com/en-us/cpp/c-language/parsing-c-command-line-arguments - a backslash is literal unless
/// it precedes a quote, so a run of backslashes before a quote (or before the closing quote) is doubled and the quote is escaped.
fn putArg(out: *u16, at: usize, arg: *u8) -> usize {
    local n: usize = cstrLen(arg)
    if n >= 4096 { return 0 }
    local plain: bool = n > 0
    for i in 0..n {
        if arg[i] == b' ' || arg[i] == b'\t' || arg[i] == b'\n' || arg[i] == 11 || arg[i] == b'"' { plain = false }
    }
    local wide: [u16; 4096]
    local w: usize = fromUtf8(arg, n, &wide[0], 4096, false)
    local p: usize = at
    if p + 2 * w + 3 >= COMMAND_CHARS { return 0 }
    if plain {
        for i in 0..w { emit(out, &p, wide[i]) }
        return p
    }
    emit(out, &p, b'"' as u16)
    local slashes: usize = 0
    for i in 0..w {
        if wide[i] == b'\\' as u16 {
            slashes++
            emit(out, &p, wide[i])
            continue
        }
        if wide[i] == b'"' as u16 {
            for r in 0..slashes { emit(out, &p, b'\\' as u16) }   // double the run before the quote
            emit(out, &p, b'\\' as u16)                              // and escape the quote itself
        }
        slashes = 0
        emit(out, &p, wide[i])
    }
    for r in 0..slashes { emit(out, &p, b'\\' as u16) }            // the run before the closing quote
    emit(out, &p, b'"' as u16)
    return p
}

fn cstrLen(s: *u8) -> usize {
    local n: usize = 0
    while s[n] != 0 { n++ }
    return n
}

/// Writes `c` at `*at` and advances `*at`.
fn emit(out: *u16, at: *usize, c: u16) {
    out[*at] = c
    *at += 1
}

/// The command line for `argv`, NUL-terminated, in `out`; false when it exceeds 32,767 characters.
fn commandLine(argv: **u8, out: *u16) -> bool {
    local at: usize = 0
    for local k := 0; argv[k] != nil; k++ {
        if k > 0 { emit(out, &at, b' ' as u16) }
        local next: usize = putArg(out, at, argv[k])
        if next == 0 { return false }
        at = next
    }
    out[at] = 0
    return true
}

/// The UTF-16 environment block for `envp`: each entry NUL-terminated, then one more NUL. Mapped with `sysMap`; nil when it cannot
/// be built. `*bytes` is the mapping size to pass to `sysUnmap`.
fn envBlock(envp: **u8, bytes: *usize) -> *u16 {
    local units: usize = 1
    for local k := 0; envp[k] != nil; k++ {
        local n: usize = 0
        while envp[k][n] != 0 { n++ }
        units += n + 1
    }
    *bytes = (units + 1) * 2
    local block: *u16 = sysMap(*bytes) as *u16
    if block == nil { return nil }
    local at: usize = 0
    for local k := 0; envp[k] != nil; k++ {
        local n: usize = 0
        while envp[k][n] != 0 { n++ }
        at += fromUtf8(envp[k], n, &block[at], units - at, true) + 1
    }
    block[at] = 0
    return block
}

/// An inheritable copy of what the child gets as standard stream `which` (0 stdin, 1 stdout, 2 stderr): the descriptor of the spec, or the one
/// of this process when the spec says -1.
fn inheritable(fd: i32, which: i32) -> i64 {
    local h: i64 = fd >= 0 ? fd as i64 : sysStdHandle(which)
    if h != 0 && h != -1 { SetHandleInformation(h, HANDLE_FLAG_INHERIT, HANDLE_FLAG_INHERIT) }
    return h
}

export fn sysSpawn(spec: *SpawnSpec, out: *SysChild) -> i32 {
    *out = SysChild { pid: -1, handle: 0, error: 0 }
    local cmd: [u16; COMMAND_CHARS]
    if !commandLine(spec.argv, &cmd[0]) {
        out.error = 206                                 // ERROR_FILENAME_EXCED_RANGE
        return -1
    }
    local wcwd: [u16; 1024]
    local dir: *u16 = nil                               // nil keeps the current directory
    if spec.cwd != nil {
        dir = &wcwd[0]
        local n: usize = 0
        while spec.cwd[n] != 0 { n++ }
        if n >= 1024 {
            out.error = 206
            return -1
        }
        fromUtf8(spec.cwd, n, &wcwd[0], 1024, true)
    }
    local envBytes: usize = 0
    local env: *u16 = nil
    if spec.envp != nil { env = envBlock(spec.envp, &envBytes) }
    if spec.envp != nil && env == nil {
        out.error = 8                                   // ERROR_NOT_ENOUGH_MEMORY
        return -1
    }
    // The handle list holds each distinct handle once: a duplicate makes CreateProcessW fail with ERROR_INVALID_PARAMETER.
    local std: [i64; 3] = [inheritable(spec.stdin, 0), inheritable(spec.stdout, 1), inheritable(spec.stderr, 2)]
    local list: [i64; 3]
    local count: u32 = 0
    for i in 0..3 {
        local seen: bool = std[i] == 0 || std[i] == -1
        for j in 0..count { if list[j] == std[i] { seen = true } }
        if !seen {
            list[count] = std[i]
            count++
        }
    }
    // STARTUPINFOEXW (x64): STARTUPINFOW is 104 bytes (cb @0, dwFlags @60, hStdInput @80, hStdOutput @88, hStdError @96), then
    // lpAttributeList @104; 112 bytes in all. https://learn.microsoft.com/en-us/windows/win32/api/winbase/ns-winbase-startupinfoexw
    local si: [u64; 14]
    si[0] = 112
    si[7] = (STARTF_USESTDHANDLES as u64) << 32
    si[10] = std[0] as u64
    si[11] = std[1] as u64
    si[12] = std[2] as u64
    local attrs: [u64; 32]                              // the attribute list for one attribute is about 48 bytes
    local size: usize = 0
    InitializeProcThreadAttributeList(nil, 1, 0, &size)  // fails with ERROR_INSUFFICIENT_BUFFER and reports the size
    local ok: bool = size <= 256 && InitializeProcThreadAttributeList(&attrs[0], 1, 0, &size) != 0
    local failed: u32 = 0
    if ok {
        defer DeleteProcThreadAttributeList(&attrs[0])
        si[13] = &attrs[0] as u64
        local pi: [u64; 3]                              // PROCESS_INFORMATION: hProcess @0, hThread @8, dwProcessId @16
        if count > 0 && UpdateProcThreadAttribute(&attrs[0], 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST, &list[0], count * 8, nil, nil) == 0 {
            failed = GetLastError()
        } else if CreateProcessW(nil, &cmd[0], nil, nil, 1, EXTENDED_STARTUPINFO_PRESENT | CREATE_UNICODE_ENVIRONMENT, env,
                                 dir, &si[0], &pi[0]) == 0 {
            failed = GetLastError()
        } else {
            out.pid = (pi[2] & 0xffffffff) as i32
            out.handle = pi[0] as i64
            CloseHandle(pi[1] as i64)                   // the primary thread handle is not needed
        }
    } else {
        failed = size > 256 ? 8 : GetLastError()
    }
    if env != nil { sysUnmap(env as *void, envBytes) }
    if out.pid < 0 {
        out.error = failed as i32
        return -1
    }
    return 0
}

/// 1: ended (`*code` is the exit code, `*sig` is 0: Windows has no signals); 0: still running (only without `block`); -1: error.
export fn sysProcWait(c: *SysChild, block: bool, code: *i32, sig: *i32) -> i32 {
    local r: u32 = WaitForSingleObject(c.handle, block ? INFINITE : 0)
    if r == WAIT_TIMEOUT { return 0 }
    if r != WAIT_OBJECT_0 { return -1 }
    local exit: u32 = 0
    if GetExitCodeProcess(c.handle, &exit) == 0 { return -1 }
    *code = exit as i32
    *sig = 0
    return 1
}

/// `sig` 0 tests that the process is still running. Any other value ends it with TerminateProcess (exit code 1): Windows has no
/// signals and no way to ask an arbitrary process to stop that always works. The handle of the child is used when there is one, so a
/// reused pid is never hit; otherwise the pid is opened. 0 on success, -1 otherwise.
export fn sysProcSignal(pid: i32, handle: i64, sig: i32) -> i32 {
    local h: i64 = handle
    if h == 0 {
        h = OpenProcess(sig == 0 ? PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE : PROCESS_TERMINATE, 0, pid as u32)
        if h == 0 { return -1 }
    }
    local result: i32 = 0
    if sig == 0 {
        result = WaitForSingleObject(h, 0) == WAIT_TIMEOUT ? 0 : -1
    } else if TerminateProcess(h, KILLED_EXIT_CODE) == 0 {
        result = -1
    }
    if handle == 0 { CloseHandle(h) }
    return result
}

/// Closes the process handle of a child that is no longer used.
export fn sysProcRelease(c: *SysChild) {
    if c.handle != 0 { CloseHandle(c.handle) }
    c.handle = 0
}

@library("kernel32") declare fn GetModuleFileNameW(module: i64, name: *u16, size: u32) -> u32

/// The path of the running executable, UTF-8, NUL-terminated, in `buf` (capacity `cap`). Its length, or -1 when it does not fit.
/// https://learn.microsoft.com/en-us/windows/win32/api/libloaderapi/nf-libloaderapi-getmodulefilenamew (a full buffer means truncation)
export fn sysExePath(buf: *u8, cap: usize) -> isize {
    local wide: [u16; 2048]
    local n: u32 = GetModuleFileNameW(0, &wide[0], 2048)
    if n == 0 || n >= 2048 { return -1 }
    local bytes: usize = toUtf8(&wide[0], n as usize, buf, cap, true)
    return bytes == 0 ? -1 : bytes as isize
}

export fn sysProcId() -> i32 {
    return GetCurrentProcessId() as i32
}

/// Whether the process token is elevated (an administrator running with the full token). With UAC off, an administrator is
/// elevated and a standard user is not.
export fn sysIsElevated() -> bool {
    local token: i64 = 0
    if OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token) == 0 { return false }
    local elevated: u32 = 0
    local returned: u32 = 0
    local ok: bool = GetTokenInformation(token, TOKEN_ELEVATION_CLASS, &elevated, 4, &returned) != 0
    CloseHandle(token)
    return ok && elevated != 0
}

/// Pipes cannot be waited on together with WaitForMultipleObjects reliably, so this polls: PeekNamedPipe reports buffered bytes, or
/// failure when the write end has closed (end-of-file), either of which makes a read return at once. See the Linux body for the result.
export fn sysPollIn(fds: *i32, n: usize, timeoutMs: i32) -> i32 {
    local waited: i32 = 0
    while true {
        for i in 0..n {
            local available: u32 = 0
            if PeekNamedPipe(fds[i] as i64, nil, 0, nil, &available, nil) == 0 || available > 0 { return i as i32 }
        }
        if timeoutMs >= 0 && waited >= timeoutMs { return -1 }
        Sleep(1)
        waited++
    }
    return -1
}


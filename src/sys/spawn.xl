// std/sys/spawn: starting, signalling and reaping child processes, the process id, and the elevation check. One area, three
// bodies; every OS fills the same two structs and returns the same results, so `std/os/process` is written once.
//
// Linux (raw syscalls, numbers in xlang-docs/std/syscalls): the parent opens a close-on-exec pipe, forks with `clone(SIGCHLD)`
//   (no CLONE_VM: a fork), and the child redirects its descriptors, changes directory and tries `execve` on each candidate.
//   When every `execve` fails, the child writes its errno into the pipe and exits with 127; the parent reads the pipe, so a
//   missing program is reported as an error of `sysSpawn` and not as a child that exits with 127. A successful `execve` closes
//   the pipe (O_CLOEXEC), and the parent reads end-of-file.
//   https://man7.org/linux/man-pages/man2/clone.2.html, https://man7.org/linux/man-pages/man2/execve.2.html,
//   https://man7.org/linux/man-pages/man2/pipe.2.html (pipe2, O_CLOEXEC), https://man7.org/linux/man-pages/man2/dup.2.html (dup3),
//   https://man7.org/linux/man-pages/man2/wait4.2.html, https://man7.org/linux/man-pages/man2/kill.2.html,
//   https://man7.org/linux/man-pages/man2/geteuid.2.html, https://man7.org/linux/man-pages/man2/poll.2.html (ppoll),
//   https://man7.org/linux/man-pages/man2/fcntl.2.html (F_DUPFD_CLOEXEC, F_SETFD), https://man7.org/linux/man-pages/man2/chdir.2.html,
//   https://man7.org/linux/man-pages/man2/sigaction.2.html (rt_sigaction).
// macOS (libSystem, the documented interface): `posix_spawn` with file actions and the attribute POSIX_SPAWN_CLOEXEC_DEFAULT, which
//   closes every descriptor the file actions do not name, so a pipe end of this process never leaks into a child.
//   https://developer.apple.com/library/archive/documentation/System/Conceptual/ManPages_iPhoneOS/man3/posix_spawn.3.html
//   Numbers and constants read from https://github.com/apple-oss-distributions/xnu: bsd/kern/syscalls.master (fcntl 92),
//   bsd/sys/fcntl.h, bsd/sys/spawn.h, bsd/sys/poll.h, bsd/sys/wait.h.
// Windows (kernel32 and advapi32, checked against Microsoft Learn): `CreateProcessW` with a STARTUPINFOEXW whose
//   PROC_THREAD_ATTRIBUTE_HANDLE_LIST names exactly the handles the child inherits, so no other inheritable handle of this process
//   leaks into it (https://learn.microsoft.com/en-us/windows/win32/api/processthreadsapi/nf-processthreadsapi-createprocessw,
//   https://learn.microsoft.com/en-us/windows/win32/api/processthreadsapi/nf-processthreadsapi-updateprocthreadattribute).
//
// A path, an argument and a variable are NUL-terminated C strings: this is the boundary to the OS. `std/os/process` owns them as
// `String` and `Vec<String>`. Descriptors are `i32`; on Windows a descriptor is the low 32 bits of a kernel handle, as in `std/sys`.

/// What to start. Every pointer stays valid for the call; arrays of pointers end with nil.
export struct SpawnSpec {
    programs: **u8   // Linux, macOS: the executables to try in order (the PATH search is done by the caller). Windows: unused.
    argv: **u8       // argv[0] first. Windows joins them into one quoted command line; its first token is searched on PATH.
    envp: **u8       // "NAME=value" entries; nil keeps the environment of this process (Windows only: Unix always gets a list)
    cwd: *u8         // working directory; nil keeps the current one
    stdin: i32       // descriptor the child gets as 0; -1 keeps the descriptor of this process
    stdout: i32      // ... as 1
    stderr: i32      // ... as 2
}

/// A started child. `handle` is the process handle on Windows (the exit status is read through it) and 0 elsewhere.
/// `error` is the OS error code (errno, or GetLastError on Windows) when `sysSpawn` fails.
export struct SysChild {
    pid: i32
    handle: i64
    error: i32
}

#if os == "linux"

from "linux" import sysClose, sysRead

#if arch == "x86_64"
define SYS_WRITE = 1
define SYS_GETPID = 39
define SYS_KILL = 62
define SYS_WAIT4 = 61
define SYS_CLONE = 56
define SYS_EXECVE = 59
define SYS_EXIT = 60
define SYS_DUP3 = 292
define SYS_PIPE2 = 293
define SYS_FCNTL = 72
define SYS_CHDIR = 80
define SYS_GETEUID = 107
define SYS_PPOLL = 271
define SYS_SIGACTION = 13
#elif arch == "aarch64"
define SYS_WRITE = 64
define SYS_GETPID = 172
define SYS_KILL = 129
define SYS_WAIT4 = 260
define SYS_CLONE = 220
define SYS_EXECVE = 221
define SYS_EXIT = 93
define SYS_DUP3 = 24
define SYS_PIPE2 = 59
define SYS_FCNTL = 25
define SYS_CHDIR = 49
define SYS_GETEUID = 175
define SYS_PPOLL = 73
define SYS_SIGACTION = 134
#endif

define SIGCHLD = 17
define SIGPIPE = 13
define O_CLOEXEC = 0x80000          // 02000000 octal, the same on x86-64 and arm64
define F_SETFD = 2
define F_DUPFD_CLOEXEC = 1030       // <linux/fcntl.h>: F_LINUX_SPECIFIC_BASE + 6
define WNOHANG = 1
define EINTR = 4
define EPERM = 1
define ENOENT = 2
define ENOTDIR = 20
define POLL_READY = 0x19            // POLLIN | POLLERR | POLLHUP: a read will not block

/// Moves a descriptor below 3 above them (close-on-exec), so redirecting 0, 1 and 2 in the child never overwrites an end
/// that has still to be copied. Only matters when this process has closed one of its own standard descriptors.
fn lift(fd: *i32) {
    if *fd >= 3 { return }
    local moved: i32 = syscall(SYS_FCNTL, *fd, F_DUPFD_CLOEXEC, 3) as i32
    if moved < 0 { return }
    sysClose(*fd)
    *fd = moved
}

global sigpipeIgnored: bool

/// The one-time process state of this area (users never call it): a write to a pipe whose reader has gone must fail with EPIPE
/// instead of ending the process with SIGPIPE, so SIGPIPE is ignored once per process, as `std/sys/sock` does for sockets.
fn spawnUp() {
    if sigpipeIgnored { return }
    local ignore: [u64; 4] = [1, 0, 0, 0]       // kernel struct sigaction: handler SIG_IGN (1), flags, restorer, mask
    syscall(SYS_SIGACTION, SIGPIPE, &ignore[0], 0, 8)
    sigpipeIgnored = true
}

/// A pipe for a child: `fds[0]` reads, `fds[1]` writes, both close-on-exec (a child gets only the end the spawn copies onto 0, 1 or 2).
export fn sysSpawnPipe(fds: *i32) -> i32 {
    spawnUp()
    if syscall(SYS_PIPE2, fds, O_CLOEXEC) < 0 { return -1 }
    for i in 0..2 { lift(&fds[i]) }
    return 0
}

/// The forked child. Only system calls run here: the heap and its locks belong to the parent's other threads. Never returns.
fn childMain(spec: *SpawnSpec, report: i32) {
    // The child must not inherit an ignored SIGPIPE: `std/sys/sock` ignores it process-wide and an ignored signal survives execve.
    local dfl: [u64; 4] = [0, 0, 0, 0]          // kernel struct sigaction: handler SIG_DFL, flags, restorer, mask
    syscall(SYS_SIGACTION, SIGPIPE, &dfl[0], 0, 8)
    local src: [i32; 3] = [spec.stdin, spec.stdout, spec.stderr]
    for fd in 0..3 {
        if src[fd] < 0 { continue }
        if src[fd] == fd {
            syscall(SYS_FCNTL, fd, F_SETFD, 0)   // keep it open across execve
        } else {
            syscall(SYS_DUP3, src[fd], fd, 0)    // the copy is not close-on-exec
        }
    }
    for fd in 0..3 {
        if src[fd] > 2 { sysClose(src[fd]) }     // a plain file opened by the caller: only the copy stays
    }
    local errno: i32 = ENOENT
    local moved: i32 = spec.cwd == nil ? 0 : syscall(SYS_CHDIR, spec.cwd) as i32
    if moved < 0 {
        errno = -moved
    } else {
        // The first error that is not "not found" wins, like execvp: a candidate that exists but is not executable is the real answer.
        for local k := 0; spec.programs[k] != nil; k++ {
            local r: i32 = syscall(SYS_EXECVE, spec.programs[k], spec.argv, spec.envp) as i32
            if r != -ENOENT && r != -ENOTDIR { errno = -r }
        }
    }
    syscall(SYS_WRITE, report, &errno as *u8, 4)
    syscall(SYS_EXIT, 127)
}

export fn sysSpawn(spec: *SpawnSpec, out: *SysChild) -> i32 {
    *out = SysChild { pid: -1, handle: 0, error: 0 }
    local report: [i32; 2]
    local r: i64 = syscall(SYS_PIPE2, &report[0], O_CLOEXEC)
    if r < 0 {
        out.error = -(r as i32)
        return -1
    }
    local pid: i64 = syscall(SYS_CLONE, SIGCHLD, 0, 0, 0, 0)
    if pid == 0 { childMain(spec, report[1]) }
    sysClose(report[1])
    if pid < 0 {
        sysClose(report[0])
        out.error = -(pid as i32)
        return -1
    }
    local errno: i32 = 0
    local got: isize = sysRead(report[0], &errno as *u8, 4)
    while got == -EINTR { got = sysRead(report[0], &errno as *u8, 4) }
    sysClose(report[0])
    if got == 4 {
        local status: i32 = 0
        syscall(SYS_WAIT4, pid, &status, 0, 0)   // reap the child that failed to start
        out.error = errno
        return -1
    }
    out.pid = pid as i32
    return 0
}

/// Reaps `c` when it has ended. 1: ended (`*code` is the exit status, or -1 when a signal ended it, which is `*sig`); 0: still
/// running (only without `block`); -1: error. A reaped child cannot be waited for again.
export fn sysProcWait(c: *SysChild, block: bool, code: *i32, sig: *i32) -> i32 {
    local status: i32 = 0
    local r: i64 = 0
    while true {
        r = syscall(SYS_WAIT4, c.pid, &status, block ? 0 : WNOHANG, 0)
        if r != -EINTR { break }
    }
    if r < 0 { return -1 }
    if r == 0 { return 0 }
    // wait(2): the low 7 bits are the terminating signal (0 for a normal exit), bits 8..15 the exit status.
    *sig = status & 0x7f
    *code = *sig == 0 ? (status >> 8) & 0xff : -1
    return 1
}

/// Sends signal `sig` (0 only tests that the process exists: EPERM means it exists but belongs to another user). 0 on success,
/// -1 otherwise. `handle` is unused here.
export fn sysProcSignal(pid: i32, handle: i64, sig: i32) -> i32 {
    local r: i64 = syscall(SYS_KILL, pid, sig)
    return r == 0 || (sig == 0 && r == -EPERM) ? 0 : -1
}

/// Windows closes the process handle here; there is nothing to release on Linux.
export fn sysProcRelease(c: *SysChild) {
}

/// The path of the running executable, UTF-8, NUL-terminated, in `buf` (capacity `cap`). Its length, or -1 when it does not fit.
/// Linux: the target of the symlink /proc/self/exe (readlink 89 on x86-64, readlinkat 78 on arm64, which has no readlink).
export fn sysExePath(buf: *u8, cap: usize) -> isize {
    local link: *u8 = "/proc/self/exe"
#if arch == "x86_64"
    local n: i64 = syscall(89, link, buf, cap - 1)
#else
    local n: i64 = syscall(78, -100, link, buf, cap - 1)
#endif
    if n <= 0 || n as usize >= cap - 1 { return -1 }    // readlink truncates silently: a full buffer may be cut
    buf[n as usize] = 0
    return n as isize
}

export fn sysProcId() -> i32 {
    return syscall(SYS_GETPID) as i32
}

/// Whether the effective user is root (uid 0).
export fn sysIsElevated() -> bool {
    return syscall(SYS_GETEUID) == 0
}

/// Waits until one of the `n` (at most 4) descriptors can be read without blocking, or has reached end-of-file or failed.
/// Returns its index, -1 on timeout, -2 on error. `timeoutMs` < 0 waits for ever.
export fn sysPollIn(fds: *i32, n: usize, timeoutMs: i32) -> i32 {
    local pfd: [i32; 8]       // struct pollfd { int fd; short events; short revents; } per entry
    for i in 0..n {
        pfd[2 * i] = fds[i]
        pfd[2 * i + 1] = 1    // POLLIN
    }
    local tmo: [i64; 2] = [(timeoutMs / 1000) as i64, ((timeoutMs % 1000) * 1000000) as i64]
    local limit: *i64 = nil                  // nil waits for ever
    if timeoutMs >= 0 { limit = &tmo[0] }
    local r: i64 = 0
    while true {
        r = syscall(SYS_PPOLL, &pfd[0], n, limit, 0, 8)
        if r != -EINTR { break }
    }
    if r < 0 { return -2 }
    for i in 0..n {
        if ((pfd[2 * i + 1] >> 16) & POLL_READY) != 0 { return i as i32 }
    }
    return -1
}

#elif os == "macos"

from "macos" import sysClose, sysPipe

@library("System") declare fn getpid() -> i32
@library("System") declare fn kill(pid: i32, sig: i32) -> i32
@library("System") declare fn wait4(pid: i32, status: *i32, options: i32, rusage: *void) -> i32
@library("System") declare fn geteuid() -> u32
@library("System") declare fn poll(fds: *i32, n: u32, timeoutMs: i32) -> i32
@library("System") declare fn __error() -> *i32          // address of errno
@library("System") declare fn posix_spawn(pid: *i32, path: *u8, fileActions: *void, attr: *void, argv: **u8, envp: **u8) -> i32
@library("System") declare fn posix_spawn_file_actions_init(actions: **void) -> i32
@library("System") declare fn posix_spawn_file_actions_destroy(actions: **void) -> i32
@library("System") declare fn posix_spawn_file_actions_adddup2(actions: **void, fd: i32, newfd: i32) -> i32
@library("System") declare fn posix_spawn_file_actions_addinherit_np(actions: **void, fd: i32) -> i32
@library("System") declare fn posix_spawn_file_actions_addchdir_np(actions: **void, path: *u8) -> i32
@library("System") declare fn posix_spawnattr_init(attr: **void) -> i32
@library("System") declare fn posix_spawnattr_destroy(attr: **void) -> i32
@library("System") declare fn posix_spawnattr_setflags(attr: **void, flags: i16) -> i32
@library("System") declare fn posix_spawnattr_setsigdefault(attr: **void, set: *u32) -> i32

define SYS_FCNTL = 92                    // bsd/kern/syscalls.master
define F_SETFD = 2                       // bsd/sys/fcntl.h
define F_DUPFD_CLOEXEC = 67
define F_SETNOSIGPIPE = 73               // bsd/sys/fcntl.h: per-descriptor SIGPIPE suppression
define FD_CLOEXEC = 1
define POSIX_SPAWN_SETSIGDEF = 0x4       // bsd/sys/spawn.h
define POSIX_SPAWN_CLOEXEC_DEFAULT = 0x4000
define SIGPIPE_BIT = 0x1000              // sigset_t is a 32-bit mask on Darwin: signal 13 is bit 12
define WNOHANG = 1                       // bsd/sys/wait.h
define EINTR = 4
define EPERM = 1
define ENOENT = 2
define ENOTDIR = 20
define POLL_READY = 0x19                 // bsd/sys/poll.h: POLLIN 0x1 | POLLERR 0x8 | POLLHUP 0x10

/// See the Linux body: a descriptor below 3 moves above them, so the file actions never overwrite an end still to be copied.
fn lift(fd: *i32) {
    syscall(SYS_FCNTL, *fd, F_SETFD, FD_CLOEXEC)
    if *fd >= 3 { return }
    local moved: i32 = syscall(SYS_FCNTL, *fd, F_DUPFD_CLOEXEC, 3) as i32
    if moved < 0 { return }
    sysClose(*fd)
    *fd = moved
}

/// A pipe for a child: `fds[0]` reads, `fds[1]` writes, both close-on-exec. macOS has no `pipe2`, so another thread that forks between
/// the two calls could inherit an end; a spawn by this module never does (POSIX_SPAWN_CLOEXEC_DEFAULT).
export fn sysSpawnPipe(fds: *i32) -> i32 {
    if sysPipe(fds, false) < 0 { return -1 }
    for i in 0..2 {
        syscall(SYS_FCNTL, fds[i], F_SETNOSIGPIPE, 1)   // a write to a gone reader fails with EPIPE instead of raising SIGPIPE
        lift(&fds[i])
    }
    return 0
}

/// Applies the redirections of `spec` as file actions. The first failing call's error code, 0 when all succeeded.
fn fileActions(actions: **void, spec: *SpawnSpec) -> i32 {
    local src: [i32; 3] = [spec.stdin, spec.stdout, spec.stderr]
    for fd in 0..3 {
        // POSIX_SPAWN_CLOEXEC_DEFAULT closes everything not named: a descriptor that stays as it is must be named too.
        local rc: i32 = src[fd] < 0 || src[fd] == fd ? posix_spawn_file_actions_addinherit_np(actions, fd)
                                                      : posix_spawn_file_actions_adddup2(actions, src[fd], fd)
        if rc != 0 { return rc }
    }
    return spec.cwd == nil ? 0 : posix_spawn_file_actions_addchdir_np(actions, spec.cwd)
}

export fn sysSpawn(spec: *SpawnSpec, out: *SysChild) -> i32 {
    *out = SysChild { pid: -1, handle: 0, error: 0 }
    local actions: *void = nil
    local attr: *void = nil
    local rc: i32 = posix_spawn_file_actions_init(&actions)
    if rc != 0 {
        out.error = rc
        return -1
    }
    defer posix_spawn_file_actions_destroy(&actions)
    // An ignored SIGPIPE survives exec and `std/sys/sock` ignores it process-wide: the child gets the default action back.
    local sigdef: u32 = SIGPIPE_BIT
    rc = posix_spawnattr_init(&attr)
    if rc != 0 {
        out.error = rc
        return -1
    }
    defer posix_spawnattr_destroy(&attr)
    rc = posix_spawnattr_setflags(&attr, (POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_CLOEXEC_DEFAULT) as i16)
    if rc == 0 { rc = posix_spawnattr_setsigdefault(&attr, &sigdef) }
    if rc == 0 { rc = fileActions(&actions, spec) }
    if rc != 0 {
        out.error = rc
        return -1
    }
    // Like execvp: "not found" moves on to the next candidate, any other error is remembered and the search goes on.
    local failure: i32 = ENOENT
    for local k := 0; spec.programs[k] != nil; k++ {
        local pid: i32 = 0
        rc = posix_spawn(&pid, spec.programs[k], &actions as *void, &attr as *void, spec.argv, spec.envp)
        if rc == 0 {
            out.pid = pid
            return 0
        }
        if rc != ENOENT && rc != ENOTDIR { failure = rc }
    }
    out.error = failure
    return -1
}

/// See the Linux body.
export fn sysProcWait(c: *SysChild, block: bool, code: *i32, sig: *i32) -> i32 {
    local status: i32 = 0
    local r: i32 = 0
    while true {
        r = wait4(c.pid, &status, block ? 0 : WNOHANG, nil)
        if r >= 0 || *__error() != EINTR { break }
    }
    if r < 0 { return -1 }
    if r == 0 { return 0 }
    // bsd/sys/wait.h: _WSTATUS is the low 7 bits (0 = exited), WEXITSTATUS is bits 8..15.
    *sig = status & 0x7f
    *code = *sig == 0 ? (status >> 8) & 0xff : -1
    return 1
}

export fn sysProcSignal(pid: i32, handle: i64, sig: i32) -> i32 {
    return kill(pid, sig) == 0 || (sig == 0 && *__error() == EPERM) ? 0 : -1
}

export fn sysProcRelease(c: *SysChild) {
}

@library("System") declare fn _NSGetExecutablePath(buf: *u8, size: *u32) -> i32

/// The path of the running executable, NUL-terminated, in `buf` (capacity `cap`). Its length, or -1 when it does not fit.
/// https://developer.apple.com/library/archive/documentation/System/Conceptual/ManPages_iPhoneOS/man3/dyld.3.html
export fn sysExePath(buf: *u8, cap: usize) -> isize {
    local size: u32 = cap as u32
    if _NSGetExecutablePath(buf, &size) != 0 { return -1 }
    local n: usize = 0
    while buf[n] != 0 { n++ }
    return n as isize
}

export fn sysProcId() -> i32 {
    return getpid()
}

export fn sysIsElevated() -> bool {
    return geteuid() == 0
}

/// See the Linux body.
export fn sysPollIn(fds: *i32, n: usize, timeoutMs: i32) -> i32 {
    local pfd: [i32; 8]
    for i in 0..n {
        pfd[2 * i] = fds[i]
        pfd[2 * i + 1] = 1    // POLLIN
    }
    local r: i32 = 0
    while true {
        r = poll(&pfd[0], n as u32, timeoutMs)
        if r >= 0 || *__error() != EINTR { break }
    }
    if r < 0 { return -2 }
    for i in 0..n {
        if ((pfd[2 * i + 1] >> 16) & POLL_READY) != 0 { return i as i32 }
    }
    return -1
}


// std/collections/result: `Result<T, E>`, a value that is either an `Ok` with the success type `T`
// or an `Err` with the error type `E`.
//
// It is an ordinary generic payload enum: a switch over both variants is exhaustive, and the live
// payload is dropped exactly once, so `Result<String, Error>` owns its string while it is an `Ok`
// and owns its error value while it is an `Err`. A variant is built as `Result.Ok(v)` or
// `Result.Err(e)` and needs a known target type where it is created, because the enum is generic
// (`local r: Result<i32, Error> = Result.Ok(1)`; without that type the build is `E0756`).
//
// `r?` takes the value of an `Ok` and returns the `Err` from the enclosing function otherwise; the
// error type must be the same in both (there is no conversion). A `switch` on an owned `Result`
// takes the payload as well:
//
//     switch step() {
//         case Result.Err(e) { return Result.Err(e) }
//         case Result.Ok(v) { /* continue with v */ }
//     }
//
// The methods below read a `Result` without a `switch`: `isOk`/`isErr` test the variant,
// `unwrap`/`expect` take the success value or panic, `unwrapOr` returns a fallback, `map`/`andThen`
// transform it, `okOption`/`errOption` drop the other side, and `mapErr` rewrites the error.
from "option" import Option
from "../str/string" import String

export enum Result<T, E> {
    Ok(T)
    Err(E)
}

impl<T, E> Result<T, E> {
    /// Whether the value is an `Ok`.
    /// @ownership `self` is borrowed, so a payload that needs drop is not dropped by the test.
    fn isOk(self: *Result<T, E>) -> bool {
        switch *self {
            case Result.Ok(v) { return true }
            case Result.Err(e) { return false }
        }
    }

    /// Whether the value is an `Err`.
    /// @ownership `self` is borrowed, so a payload that needs drop is not dropped by the test.
    fn isErr(self: *Result<T, E>) -> bool {
        switch *self {
            case Result.Ok(v) { return false }
            case Result.Err(e) { return true }
        }
    }

    /// @contract the success value of an `Ok`; panics on an `Err` with a fixed message, because a
    /// @contract result the caller believes successful is a program error, not a value.
    /// @ownership the value is moved out of `self`, and the error payload (if any) is dropped here,
    /// @ownership so an `Ok` payload is owned by the caller exactly once.
    fn unwrap(self) -> T {
        switch self {
            case Result.Ok(v) { return v }
            case Result.Err(e) { panic("Result: unwrap of Err") }
        }
    }

    /// @contract the success value of an `Ok`; panics on an `Err` with a message ending in `msg`,
    /// @contract which should name what the caller expected.
    /// @ownership the value is moved out exactly as `unwrap` moves it.
    /// @cost one `String` built only on the panic path, so the happy path allocates nothing.
    fn expect(self, msg: str) -> T {
        switch self {
            case Result.Ok(v) { return v }
            case Result.Err(e) {
                local text: String = String("Result: expect on Err: ")
                text.append(msg)
                panic(text.cstr())
            }
        }
    }

    /// The success value of an `Ok`, or `fallback` for an `Err`.
    fn unwrapOr(self, fallback: T) -> T {
        switch self {
            case Result.Ok(v) { return v }
            case Result.Err(e) { return fallback }
        }
    }

    /// The success value of an `Ok`, or the error of an `Err`.
    fn unwrapErr(self) -> E {
        switch self {
            case Result.Ok(v) { panic("Result: unwrapErr of Ok") }
            case Result.Err(e) { return e }
        }
    }

    /// `Ok(f(value))` for an `Ok`, `Err` unchanged for an `Err`.
    /// @cost one move of the payload through `f`; a droppable `T` is dropped once, at the end.
    /// @todo `f` is a plain `fn(*T) -> U`, not a generic `F`, because a `U` reached only through an
    /// @todo `F` parameter is not inferred (`E0724`); a capturing closure must be a named function.
    fn map<U>(self: *Result<T, E>, f: fn(*T) -> U) -> Result<U, E> {
        local out: Result<U, E>
        switch *self {
            case Result.Ok(v) { out = Result.Ok(f(&v)) }
            case Result.Err(e) { out = Result.Err(e) }
        }
        return out
    }

    /// `f(value)` for an `Ok`, `Err` unchanged for an `Err`: the chain stops at the first `Err`.
    fn andThen<U>(self: *Result<T, E>, f: fn(*T) -> Result<U, E>) -> Result<U, E> {
        switch *self {
            case Result.Ok(v) { return f(&v) }
            case Result.Err(e) {
                local out: Result<U, E> = Result.Err(e)
                return out
            }
        }
    }

    /// `f(err)` for an `Err`, `Ok` unchanged for an `Ok`.
    fn mapErr<G>(self: *Result<T, E>, f: fn(*E) -> G) -> Result<T, G> {
        local out: Result<T, G>
        switch *self {
            case Result.Ok(v) { out = Result.Ok(v) }
            case Result.Err(e) { out = Result.Err(f(&e)) }
        }
        return out
    }

    /// The success value as a `Some`, or `None` for an `Err`, which is dropped.
    fn okOption(self) -> Option<T> {
        local out: Option<T>
        switch self {
            case Result.Ok(v) { out = Option.Some(v) }
            case Result.Err(e) { out = Option.None }
        }
        return out
    }

    /// The error as a `Some`, or `None` for an `Ok`, which is dropped.
    fn errOption(self) -> Option<E> {
        local out: Option<E>
        switch self {
            case Result.Ok(v) { out = Option.None }
            case Result.Err(e) { out = Option.Some(e) }
        }
        return out
    }

    /// Takes the success value through `out` and reports whether it was an `Ok`; an `Err` writes
    /// nothing.
    /// @ownership the payload is moved into `*out`; `self` is left unset and not run again.
    fn takeOk(self: *Result<T, E>, out: *T) -> bool {
        switch *self {
            case Result.Ok(v) {
                *out = v
                return true
            }
            case Result.Err(e) { return false }
        }
    }

    /// Takes the error value through `out` and reports whether it was an `Err`; an `Ok` writes
    /// nothing.
    /// @ownership the payload is moved into `*out`; `self` is left unset and not run again.
    fn takeErr(self: *Result<T, E>, out: *E) -> bool {
        switch *self {
            case Result.Ok(v) { return false }
            case Result.Err(e) {
                *out = e
                return true
            }
        }
    }
}

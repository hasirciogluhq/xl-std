// std/collections/hash: the key interface the containers hash through, and the SipHash-1-3 hasher
// every container uses by default.
//
// Two separate pieces, because the language cannot implement an interface on a primitive
// (`E0706`: only a struct or a class has `impl`) and generic code cannot call an interface method
// on a bare `T` (`E0404`; see `xlang-docs/known-limitations.md`):
//
// * `HashKey` is what a key type implements: one function from the key to `u64`. A container of
//   `K` needs `K: HashKey`, so the key of a `HashMap`/`HashSet` is a *struct* (a one-field wrapper
//   is enough for an integer: `struct Id { v: u64 }`).
// * `Hash` is the seeded hasher *object* a container owns. The default, `SipHash13`, is keyed from
//   process entropy through `SeedHasher`, so an attacker choosing keys cannot drive the table into
//   quadratic behavior (HashDoS). A caller that wants a fast unkeyed table passes its own `Hash`.
//
// A key combines its fields by folding each one into the running hash:
//
//     struct Key { a: i32, b: i32 }
//     impl HashKey for Key {
//         fn hashKey(self, seed: u64) -> u64 { return hashU64(self.b as u64, hashI32(self.a, seed)) }
//     }
//
// SipHash-1-3 is SipHash with one compression round and three finalization rounds: the variant the
// designers recommend for the short keys a hash table uses. FNV stays in `std/checksum` for error
// detection, where an unkeyed, published constant is the point.
from "../random/entropy" import randomU64
from "../str/string" import String
from "../str/compare" import compare

/// What a value must provide to be a table key: its hash under a running seed, and equality with
/// another key.
///
/// Equality is a method rather than `fn ==` on purpose: an operator function is found only in the
/// module that declares it and in the generic code's own module, so a `String` key in a generic
/// table cannot rely on `==` (`E0709`). A method on the interface is dispatched through the value.
export interface HashKey {
    /// The hash of `self`, combined with `seed` (the hash of the fields already folded in, or the
    /// table's per-key seed). Equal values must return equal results.
    fn hashKey(self, seed: u64) -> u64

    /// Whether `self` equals the key whose address is `other`: the only comparison a probe makes.
    /// `other` is typed `*void` because an interface value cannot be cast back to a concrete type
    /// (`E0709`), so the implementor casts the pointer itself. `a.equalsKey(b)` and
    /// `b.equalsKey(a)` must agree, and a value must equal itself.
    /// @safety `other` must point to a value of the implementing type; a table only ever passes a
    /// @safety lookup key of the same `K`, so the cast inside an implementation is sound.
    fn equalsKey(self, other: *void) -> bool
}

/// A seeded hash function. A container owns one and calls `hash` for every key, so replacing the
/// hasher is a matter of passing a different implementation rather than changing the key type.
export interface Hash {
    /// The hash of the `n` bytes at `data`, combined with `seed`.
    /// @ownership `data` is borrowed for the call only and is never freed here.
    fn hash(self, data: *u8, n: usize, seed: u64) -> u64
}

// SipHash's "nothing up my sleeve" constants from the paper, unchanged.
// @spec https://www.aumasson.jp/siphash/siphash.pdf section 2.3 for the four initial values.
define SIP_C0 = 0x736f6d6570736575
define SIP_C1 = 0x646f72616e646f6d
define SIP_C2 = 0x6c7967656e657261
define SIP_C3 = 0x7465646279746573

/// Rotates `x` left by `n` bits.
fn rotl(x: u64, n: u32) -> u64 {
    return (x << n) | (x >> (64 - n))
}

/// One SipHash round: the four ARX steps of section 2.4 of the paper, in place on the state.
fn sipRound(v0: *u64, v1: *u64, v2: *u64, v3: *u64) {
    *v0 += *v1
    *v1 = rotl(*v1, 13)
    *v1 ^= *v0
    *v0 = rotl(*v0, 32)
    *v2 += *v3
    *v3 = rotl(*v3, 16)
    *v3 ^= *v2
    *v0 += *v3
    *v3 = rotl(*v3, 21)
    *v3 ^= *v0
    *v2 += *v1
    *v1 = rotl(*v1, 17)
    *v1 ^= *v2
    *v2 = rotl(*v2, 32)
}

/// SipHash-1-3 of `data[0..n]` with the 128-bit key `(k0, k1)`, as a 64-bit tag.
/// @contract every byte of `data` and both key words affect the tag; the same input and key give
/// @contract the same tag, and a different key gives an unrelated one.
/// @spec https://www.aumasson.jp/siphash/siphash.pdf section 2 for the construction; the test
/// @spec suite checks the output against the reference implementation's SipHash-1-3 vectors.
/// @ownership `data` is borrowed for the call; it is never NUL-terminated, copied or freed.
/// @cost one pass over the input with one round per 8-byte block, then three finalization rounds;
/// @cost no allocation.
export fn siphash13(k0: u64, k1: u64, data: *u8, n: usize) -> u64 {
    local v0: u64 = k0 ^ SIP_C0
    local v1: u64 = k1 ^ SIP_C1
    local v2: u64 = k0 ^ SIP_C2
    local v3: u64 = k1 ^ SIP_C3
    // Each full 8-byte block is one compression round (SipHash-1).
    local i: usize = 0
    while i + 8 <= n {
        local block: u64 = loadLe64(data, i)
        v3 ^= block
        sipRound(&v0, &v1, &v2, &v3)
        v0 ^= block
        i += 8
    }
    // The tail is the remaining bytes little-endian in a word whose top byte is the message length,
    // which is what makes a 0 and a 1 byte message hash differently (section 2.3).
    local last: u64 = (n as u64 & 0xff) << 56
    local tail: usize = 0
    while tail < (n & 7) {
        last |= (data[i + tail] as u64) << (8 * tail as u32)
        tail++
    }
    v3 ^= last
    sipRound(&v0, &v1, &v2, &v3)
    v0 ^= last
    // Three finalization rounds (SipHash-3).
    v2 ^= 0xff
    sipRound(&v0, &v1, &v2, &v3)
    sipRound(&v0, &v1, &v2, &v3)
    sipRound(&v0, &v1, &v2, &v3)
    return v0 ^ v1 ^ v2 ^ v3
}

/// SipHash-1-3 of a `str` with the key `(k0, k1)`.
/// @ownership `s` is borrowed; its bytes are hashed in place.
export fn siphash13Str(k0: u64, k1: u64, s: str) -> u64 {
    return siphash13(k0, k1, s.ptr, s.len)
}

/// Reads 8 bytes of `data` at `at` as a little-endian `u64`, so a key hashes the same on a
/// little-endian and a big-endian target.
/// @safety `at + 8` must not exceed the length of `data`; the only caller tests `i + 8 <= n`.
fn loadLe64(data: *u8, at: usize) -> u64 {
    local v: u64 = 0
    for k in 0..8 {
        v |= (data[at + k as usize] as u64) << (8 * k as u32)
    }
    return v
}

/// The default hasher: SipHash-1-3 with a 128-bit key the table keeps. Two tables built from two
/// `newSeed` calls use different keys, so a key stream chosen against one is useless against the
/// other.
/// @spec https://www.aumasson.jp/siphash/siphash.pdf section 2 for the algorithm.
/// @ownership the value holds two words and owns no memory.
export struct SipHash13 {
    k0: u64
    k1: u64
}

impl Hash for SipHash13 {
    fn hash(self, data: *u8, n: usize, seed: u64) -> u64 {
        // The running seed is folded into the key, so folding one field after another stays one
        // SipHash call per field and the two key words stay independent of the seed.
        return siphash13(self.k0 ^ seed, self.k1, data, n)
    }
}

/// @contract a fresh `SipHash13` keyed from OS entropy, so two calls (and so two tables) almost
/// @contract never share a key; the key is not reproducible and need not be.
/// @cost one entropy read.
export fn newSeed() -> SipHash13 {
    return SipHash13 { k0: randomU64(), k1: randomU64() }
}

// ---- folding a key's fields into one hash -------------------------------------------------
//
// The helpers take the hash of the earlier fields as `seed` and mix one value in, so a key's
// `hashKey` is a nested expression over them and every key type keeps the same behaviour. Each
// one is a single SipHash-1-3 call over the value's 8 little-endian bytes, with the seed split
// into the key by two odd multipliers (no sharing between the two key words).

fn seedKey0(seed: u64) -> u64 {
    return seed * 0x9e3779b97f4a7c15
}

fn seedKey1(seed: u64) -> u64 {
    return seed ^ 0xd6e8feb86659fd93
}

/// Folds an `i32` field into the running hash `seed`.
/// @cost one SipHash call, no allocation.
export fn hashI32(v: i32, seed: u64) -> u64 {
    local w: u64 = v as u64
    return siphash13(seedKey0(seed), seedKey1(seed), &w as *u8, 8)
}

/// Folds a `u64` field into the running hash `seed`.
/// @cost one SipHash call, no allocation.
export fn hashU64(v: u64, seed: u64) -> u64 {
    local w: u64 = v
    return siphash13(seedKey0(seed), seedKey1(seed), &w as *u8, 8)
}

/// Folds a `bool` field into the running hash `seed`.
export fn hashBool(v: bool, seed: u64) -> u64 {
    local w: u64 = v ? 1 : 0
    return siphash13(seedKey0(seed), seedKey1(seed), &w as *u8, 8)
}

/// Folds a `str` field into the running hash `seed`.
/// @ownership `s` is borrowed; its bytes are hashed in place.
export fn hashStr(s: str, seed: u64) -> u64 {
    return siphash13(seedKey0(seed), seedKey1(seed), s.ptr, s.len)
}

/// Folds an owned `String` field into the running hash `seed`.
/// @ownership `s` is borrowed; nothing is copied or freed.
export fn hashString(s: *String, seed: u64) -> u64 {
    return hashStr(s.asStr(), seed)
}

// ---- the key types the containers ship ---------------------------------------------------
//
// A one-field wrapper per primitive: the language cannot impl an interface on `i32` itself, and a
// table of integers is common enough that the wrapper is worth shipping. A `String` key is its
// own type and implements the interface directly.

/// An `i32` as a table key.
export struct I32Key { v: i32 }
impl HashKey for I32Key {
    fn hashKey(self, seed: u64) -> u64 { return hashI32(self.v, seed) }

    fn equalsKey(self, other: *void) -> bool {
        local o: *I32Key = other as *I32Key
        local same: bool = self.v == o.v
        return same
    }
}
fn ==(a: *I32Key, b: *I32Key) -> bool { return a.v == b.v }
fn <(a: *I32Key, b: *I32Key) -> bool { return a.v < b.v }

/// A `u64` as a table key.
export struct U64Key { v: u64 }
impl HashKey for U64Key {
    fn hashKey(self, seed: u64) -> u64 { return hashU64(self.v, seed) }

    fn equalsKey(self, other: *void) -> bool {
        local o: *U64Key = other as *U64Key
        local same: bool = self.v == o.v
        return same
    }
}
fn ==(a: *U64Key, b: *U64Key) -> bool { return a.v == b.v }
fn <(a: *U64Key, b: *U64Key) -> bool { return a.v < b.v }

/// An `i64` as a table key (the bits are the hash input, so `-1` and `u64` max differ).
export struct I64Key { v: i64 }
impl HashKey for I64Key {
    fn hashKey(self, seed: u64) -> u64 { return hashU64(self.v as u64, seed) }

    fn equalsKey(self, other: *void) -> bool {
        local o: *I64Key = other as *I64Key
        local same: bool = self.v == o.v
        return same
    }
}
fn ==(a: *I64Key, b: *I64Key) -> bool { return a.v == b.v }
fn <(a: *I64Key, b: *I64Key) -> bool { return a.v < b.v }

impl HashKey for String {
    fn hashKey(self, seed: u64) -> u64 { return hashStr(self.asStr(), seed) }

    fn equalsKey(self, other: *void) -> bool {
        local o: *String = other as *String
        return self.equals(o)
    }
}
/// `==` on a `String` and `<` on a `String` are declared beside the type in `str/string`; this
/// module imports it, so a generic probe in a table resolves them.

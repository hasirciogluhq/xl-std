// std/str/fmtspec: the placeholder engine — a format string, its arguments, and the text that reaches the sink.
// `fmt` holds the declarations every caller imports (`Writer`, `Display`, `FmtSink` and the constant kinds); this
// file holds the bodies, because only a module that imports both `fmt` and `str/string` may call `String` at all
// and `fmt` cannot (see the header of `fmt` for the module cycle). The digits of a float come from `fmtfloat`.
//
// A placeholder is `{}` or `{:<spec>}`, where `<spec>` is `[[fill]align][sign][#][0][width][.precision][type]`:
//
//   fill       any byte except `{`, `}`, `:`, written before the align character ("fill" then "<" gives "fill<")
//   align      `<` left, `>` right, `^` center; a spec with fill and no align still needs the align byte
//   sign       `+` always writes a sign, `-` only a negative one (the default), ` ` writes a space for a positive one
//   `#`        the alternate form: `0x`/`0b`/`0o` before a hex/binary/octal digit string, after the sign
//   `0`        zero fill, right aligned, after the sign and prefix ("{:+08x}")
//   width      the minimum number of bytes; the pad goes before the sign/prefix, or after it for `0`
//   `.precision` for a float the digits after the point (`e`, `f`, none) or significant digits (`g`); for a string
//              the maximum bytes written, never splitting a UTF-8 sequence; at most `PRECISION_MAX`
//   type       `d` `x` `X` `b` `o` for an integer, `e` `E` `f` `F` `g` `G` for a float, `s` `?` for text, `p` for a
//              pointer (`*u8`, written as `0x` and its address); none means the type of the argument
//
// `{{` and `}}` write one brace. A placeholder count that differs from the argument count is a panic, as is a spec
// the argument's type cannot use (a spec on a `bool`, a precision on an integer): a format string is fixed text in
// the program, so the mistake is the programmer's and must not be silently dropped.
//
// The engine writes through `FmtSink`, which is either a file descriptor, a caller buffer or a `String`; the bytes of
// one value are built in a fixed stack buffer and written once, so formatting allocates only for the `String` target.
//
// @spec https://doc.rust-lang.org/std/fmt/index.html#syntax for the spec grammar this one follows.
from "string" import String
from "fmt" import FmtSink, FmtString, FmtBuffer, Display
from "str" import fromParts, view, fromC
from "chars" import isDigit
from "fmtfloat" import floatText, putShortestExact, FLOAT_BUF, PRECISION_MAX
from "panic" import PanicText, panicText
from "../math/float" import f64Bits

// ---- the spec ---------------------------------------------------------------------------------

/// One parsed placeholder spec. `fill` is 0 when no fill byte was written and `align` is 0 when the spec named no
/// alignment; `typeCh` is 0 when no type letter was written. The parser stores what it read and the per-type renderer
/// asks only for what its type can honour, so a spec is never silently reinterpreted.
struct Spec {
    fill: u8
    align: u8
    signPlus: bool
    signSpace: bool
    alternate: bool
    zero: bool
    width: usize
    hasPrecision: bool
    precision: usize
    typeCh: u8
}

fn defaultSpec() -> Spec {
    return Spec {
        fill: 0, align: 0, signPlus: false, signSpace: false, alternate: false, zero: false,
        width: 0, hasPrecision: false, precision: 0, typeCh: 0,
    }
}

/// True when the spec asks for nothing: the common `{}`, which renders the value's own text with no padding.
fn specIsEmpty(sp: Spec) -> bool {
    return sp.fill == 0 && sp.align == 0 && !sp.signPlus && !sp.signSpace && !sp.alternate && !sp.zero &&
        sp.width == 0 && !sp.hasPrecision && sp.typeCh == 0
}

/// Panics for a spec an argument cannot use. `why` names the rule in a few words; the message adds the type letter.
fn specPanic(why: str, typeCh: u8) {
    local m: PanicText = panicText()
    m.text("format: ")
    m.text(why)
    m.text(" cannot be used with `")
    if typeCh != 0 { m.byte(typeCh) } else { m.text("this type") }
    m.text("`")
    m.raise()
}

/// The sign a number is written with under `sp`: `-` for a negative value, else `+` or a space when the spec asks.
fn signOf(sp: Spec, negative: bool) -> str {
    if negative { return "-" }
    return sp.signPlus ? "+" : sp.signSpace ? " " : ""
}

// ---- padding ----------------------------------------------------------------------------------

/// The pad buffer holds a whole padded value up to this many bytes; a wider width is written in `PAD_CHUNK` pieces, so
/// nothing allocates for a pad and no `String` is built per fill byte.
define PAD_BUF = 512
define PAD_CHUNK = 64

/// Writes `sp.width` padding bytes and the text between them, honouring fill, alignment and (for a zero-filled
/// number) where the sign and prefix sit. `body` is the digits, `head` the sign and prefix written in front of them.
/// One piece when the whole value fits `PAD_BUF`, so a sink sees one write.
fn emitPadded(sink: *FmtSink, sp: Spec, head: str, body: str) {
    local total: usize = head.len + body.len
    if total >= sp.width {
        sink.writeBytes(head)
        sink.writeBytes(body)
        return
    }
    local pad: usize = sp.width - total
    local fill: u8 = sp.fill != 0 ? sp.fill : b' '
    local chunk: [u8; PAD_CHUNK] = [fill; PAD_CHUNK]
    if sp.zero {
        // The sign and prefix first, then the zeros, then the digits.
        sink.writeBytes(head)
        writePad(sink, &chunk[0], pad)
        sink.writeBytes(body)
        return
    }
    local left: usize = 0
    local right: usize = 0
    switch sp.align {
    case b'<' { right = pad }
    case b'^' {
        left = pad / 2
        right = pad - left
    }
    default { left = pad }
    }
    if total + pad > PAD_BUF {
        // A width past the stack buffer is written in pieces: the pad, the text, the rest of the pad.
        writePad(sink, &chunk[0], left)
        sink.writeBytes(head)
        sink.writeBytes(body)
        writePad(sink, &chunk[0], right)
        return
    }
    local buf: [u8; PAD_BUF]
    local at: usize = 0
    for k in 0..left { buf[at + k] = fill }
    at += left
    for c, k in head { buf[at + k] = c }
    at += head.len
    for c, k in body { buf[at + k] = c }
    at += body.len
    for k in 0..right { buf[at + k] = fill }
    sink.writeBytes(fromParts(&buf[0], at + right))
}

/// Writes `n` fill bytes from `chunk`, which holds `PAD_CHUNK` of them.
fn writePad(sink: *FmtSink, chunk: *u8, n: usize) {
    for local done: usize = 0; done < n; done += PAD_CHUNK {
        local piece: usize = n - done < PAD_CHUNK ? n - done : PAD_CHUNK
        sink.writeBytes(fromParts(chunk, piece))
    }
}

// ---- the spec parser --------------------------------------------------------------------------

/// Parses the spec between `{:` and `}` starting at `text[at]`; returns the parsed spec and sets `end` to the position
/// of the closing brace. A spec without its `}`, or with a precision over `PRECISION_MAX`, is a panic, since the
/// format text is fixed.
fn parseSpec(text: str, atIn: usize, end: *usize) -> Spec {
    local sp: Spec = defaultSpec()
    local at: usize = atIn
    // [[fill]align]: a fill byte and the align byte, or just the align byte.
    if at + 1 < text.len && isAlign(text[at + 1]) && text[at] != b'}' {
        sp.fill = text[at]
        sp.align = text[at + 1]
        at += 2
    } else if at < text.len && isAlign(text[at]) {
        sp.align = text[at]
        at++
    }
    if at < text.len {
        switch text[at] {
        case b'+' {
            sp.signPlus = true
            at++
        }
        case b' ' {
            sp.signSpace = true
            at++
        }
        // `-` is the default: a sign only for a negative value.
        case b'-' { at++ }
        default {}
        }
    }
    if at < text.len && text[at] == b'#' {
        sp.alternate = true
        at++
    }
    if at < text.len && text[at] == b'0' {
        sp.zero = true
        sp.fill = b'0'
        at++
    }
    while at < text.len && isDigit(text[at]) {
        sp.width = sp.width * 10 + (text[at] - b'0') as usize
        at++
    }
    if at < text.len && text[at] == b'.' {
        sp.hasPrecision = true
        at++
        while at < text.len && isDigit(text[at]) {
            sp.precision = sp.precision * 10 + (text[at] - b'0') as usize
            if sp.precision > PRECISION_MAX { specPanic("a precision over 1024", 0) }
            at++
        }
    }
    if at < text.len && text[at] != b'}' {
        sp.typeCh = text[at]
        at++
    }
    if at >= text.len || text[at] != b'}' {
        specPanic("a spec without a closing `}`", 0)
    }
    *end = at
    return sp
}

fn isAlign(c: u8) -> bool {
    return c == b'<' || c == b'>' || c == b'^'
}

// ---- per-type rendering -----------------------------------------------------------------------

/// The text of an integer of magnitude `v` under `sp`. `typeCh` picks the base; the sign and the alternate prefix go
/// into `head` (sign first: `+0x1f`), the digits into `body`, and `emitPadded` puts the fill between them.
fn renderInteger(sink: *FmtSink, sp: Spec, v: u64, negative: bool) {
    local radix: u64 = 10
    local prefix: str = ""
    switch sp.typeCh {
    case 0, b'd' {}
    case b'x' {
        radix = 16
        prefix = "0x"
    }
    case b'X' {
        radix = 16
        prefix = "0X"
    }
    case b'b' {
        radix = 2
        prefix = "0b"
    }
    case b'o' {
        radix = 8
        prefix = "0o"
    }
    default { specPanic("this base", sp.typeCh) }
    }
    if sp.hasPrecision { specPanic("a precision on an integer", sp.typeCh) }
    // The digits, least significant first, then turned around: at most 64 for base 2.
    local rev: [u8; 64]
    local n: usize = 0
    local alphabet: str = sp.typeCh == b'X' ? "0123456789ABCDEF" : "0123456789abcdef"
    for local t: u64 = v; n == 0 || t > 0; t /= radix {
        rev[n] = alphabet[(t % radix) as usize]
        n++
    }
    local body: [u8; 64]
    for i in 0..n { body[i] = rev[n - 1 - i] }
    local sign: str = signOf(sp, negative)
    local head: [u8; 4]
    local headLen: usize = 0
    for c in sign {
        head[headLen] = c
        headLen++
    }
    if sp.alternate {
        for c in prefix {
            head[headLen] = c
            headLen++
        }
    }
    emitPadded(sink, sp, fromParts(&head[0], headLen), fromParts(&body[0], n))
}

/// The text of a signed integer under `sp`. The magnitude is the two's complement negation, so `i64`'s minimum (which
/// `0 - v` cannot represent) gives its own magnitude.
fn renderSigned(sink: *FmtSink, sp: Spec, v: i64) {
    renderInteger(sink, sp, v < 0 ? ~(v as u64) + 1 : v as u64, v < 0)
}

/// Renders `v` under `sp`: the sign, the text `floatText` builds, then the padding of `emitPadded`.
fn renderFloat(sink: *FmtSink, sp: Spec, v: f64) {
    local upper: bool = sp.typeCh == b'E' || sp.typeCh == b'F' || sp.typeCh == b'G'
    local lowerType: u8 = upper ? sp.typeCh + (b'a' - b'A') : sp.typeCh
    if lowerType != 0 && lowerType != b'e' && lowerType != b'f' && lowerType != b'g' {
        specPanic("this base", sp.typeCh)
    }
    local bits: u64 = f64Bits(v)
    local sign: str = signOf(sp, bits >> 63 == 1)
    // A non-finite value has no digits: one of the names, with no precision applied and padded like text.
    if (bits >> 52) & 0x7ff == 0x7ff {
        local nan: bool = bits & 0xfffffffffffff != 0
        emitPadded(sink, sp, nan ? "" : sign, nan ? (upper ? "NaN" : "nan") : (upper ? "INF" : "inf"))
        return
    }
    local x: f64 = bits >> 63 == 1 ? 0.0 - v : v
    // The shortest form of a value whose exact decimal fits a `u64` is written straight into a stack buffer, so the
    // common float print never reaches the allocator (the print family promises no allocator call). Every other case
    // needs `BigInt` for the exact digits and goes through a `String`.
    if !sp.hasPrecision && lowerType == 0 {
        local buf: [u8; FLOAT_BUF]
        local at: usize = 0
        if putShortestExact(&buf[0], FLOAT_BUF, &at, x) {
            emitPadded(sink, sp, sign, fromParts(&buf[0], at))
            return
        }
    }
    local text: String = String()
    floatText(&text, x, lowerType, sp.hasPrecision ? sp.precision : 6, sp.hasPrecision)
    if upper { text = text.replaceAll("e", "E") }
    emitPadded(sink, sp, sign, text.asStr())
}

/// The text of `t` under `sp`: `.precision` cuts it to that many bytes (never splitting a UTF-8 sequence), and the
/// width pads it like any other text.
fn renderText(sink: *FmtSink, sp: Spec, t: str) {
    if sp.typeCh != 0 && sp.typeCh != b's' && sp.typeCh != b'?' { specPanic("this type", sp.typeCh) }
    local cut: usize = t.len
    if sp.hasPrecision && sp.precision < t.len {
        // Back up over a continuation byte so the cut never lands inside a character.
        cut = sp.precision
        while cut > 0 && (t[cut] & 0xc0) == 0x80 { cut-- }
    }
    emitPadded(sink, sp, "", view(t, 0, cut))
}

/// The text of a pointer for `{:p}`: `0x` and the address in lowercase hex digits, padded like a number.
fn renderPointer(sink: *FmtSink, sp: Spec, p: *u8) {
    local isp: Spec = sp
    isp.typeCh = b'x'
    isp.alternate = true
    renderInteger(sink, isp, p as u64, false)
}

// ---- the engine ------------------------------------------------------------------------------

/// The number of `{}` placeholders in `text`: `{{` and `}}` are escapes and are not counted.
fn placeholders(text: str) -> usize {
    local n: usize = 0
    local i: usize = 0
    while i < text.len {
        local c: u8 = text[i]
        local doubled: bool = i + 1 < text.len && text[i + 1] == c
        if (c == b'{' || c == b'}') && doubled {
            i += 2
            continue
        }
        if c == b'{' { n++ }
        i++
    }
    return n
}

/// Panics for a format whose placeholder count differs from its argument count; the message names both counts and the
/// format text cut to 160 bytes, and is built on the stack.
fn mismatchPanic(n: usize, arity: usize, text: str) {
    local m: PanicText = panicText()
    m.text("format: ")
    m.number(n as u64)
    m.text(" placeholders, got ")
    m.number(arity as u64)
    m.text(" arguments in \"")
    m.text(view(text, 0, text.len < 160 ? text.len : 160))
    m.text("\"")
    m.raise()
}

/// One format being written: `at` is the next byte of `text` not yet written.
class Format {
    sink: *FmtSink
    text: str
    at: usize

    fn init(self, sink: *FmtSink, text: str) {
        self.sink = sink
        self.text = text
        self.at = 0
    }

    /// Checks that the format has exactly `arity` placeholders; panics otherwise.
    fn check(self, arity: usize) {
        local n: usize = placeholders(self.text)
        if n != arity { mismatchPanic(n, arity, self.text) }
    }

    /// Writes the text up to the next placeholder, or to the end. `{{` and `}}` each write one brace.
    fn literal(self) {
        local start: usize = self.at
        while self.at < self.text.len {
            local c: u8 = self.text[self.at]
            local next: u8 = self.at + 1 < self.text.len ? self.text[self.at + 1] : 0
            if c == b'{' && (next == b'}' || next == b':') { break }
            if (c == b'{' || c == b'}') && next == c {
                // Everything before the escape, then one brace of it.
                self.sink.writeBytes(view(self.text, start, self.at + 1 - start))
                self.at += 2
                start = self.at
            } else {
                self.at++
            }
        }
        if self.at > start { self.sink.writeBytes(view(self.text, start, self.at - start)) }
    }

    /// Writes the text before the next placeholder, then returns its spec and moves past its `}`.
    fn next(self) -> Spec {
        self.literal()
        // `at` is on `{`; the placeholder is `{}` or `{:spec}`.
        if self.at + 1 < self.text.len && self.text[self.at + 1] == b'}' {
            self.at += 2
            return defaultSpec()
        }
        local end: usize = self.at + 2
        local sp: Spec = parseSpec(self.text, self.at + 2, &end)
        self.at = end + 1
        return sp
    }
}

fn formatArg(f: *Format, v: i64) {
    renderSigned(f.sink, f.next(), v)
}

fn formatArg(f: *Format, v: u64) {
    renderInteger(f.sink, f.next(), v, false)
}

fn formatArg(f: *Format, v: f64) {
    renderFloat(f.sink, f.next(), v)
}

fn formatArg(f: *Format, v: bool) {
    local sp: Spec = f.next()
    if !specIsEmpty(sp) { specPanic("a spec on a bool", sp.typeCh) }
    f.sink.writeBytes(v ? "true" : "false")
}

fn formatArg(f: *Format, v: str) {
    renderText(f.sink, f.next(), v)
}

fn formatArg(f: *Format, v: *String) {
    renderText(f.sink, f.next(), v.asStr())
}

/// A `String` by value, which is how `format("{}", text)` and an interpolated `String` reach the engine. The width
/// and precision rules are the `str` ones, so the text renders exactly as a literal would.
fn formatArg(f: *Format, v: String) {
    renderText(f.sink, f.next(), v.asStr())
}

/// A `*u8` is NUL-terminated text, or with `{:p}` the address itself.
fn formatArg(f: *Format, v: *u8) {
    local sp: Spec = f.next()
    if sp.typeCh == b'p' {
        renderPointer(f.sink, sp, v)
        return
    }
    renderText(f.sink, sp, fromC(v))
}

fn formatArg(f: *Format, v: *Display) {
    local sp: Spec = f.next()
    local text: String = String()
    v.display(&text)
    renderText(f.sink, sp, text.asStr())
}

/// The per-type text a plain print writes, with no spec: the same text `{}` gives.
export fn fmtWrite(out: *FmtSink, s: str) {
    out.writeBytes(s)
}

export fn fmtWrite(out: *FmtSink, p: *u8) {
    out.writeBytes(fromC(p))
}

export fn fmtWrite(out: *FmtSink, v: i64) {
    renderSigned(out, defaultSpec(), v)
}

export fn fmtWrite(out: *FmtSink, v: u64) {
    renderInteger(out, defaultSpec(), v, false)
}

export fn fmtWrite(out: *FmtSink, v: f64) {
    renderFloat(out, defaultSpec(), v)
}

export fn fmtWrite(out: *FmtSink, b: bool) {
    out.writeBytes(b ? "true" : "false")
}

export fn fmtWrite(out: *FmtSink, s: *String) {
    out.writeBytes(s.asStr())
}

export fn fmtWrite(out: *FmtSink, d: *Display) {
    local text: String = String()
    d.display(&text)
    out.writeBytes(text.asStr())
}

/// Writes `fmt` to the sink; each placeholder takes the next argument, `{{` and `}}` write one brace. It is a panic
/// when the placeholder count and the argument count differ.
export fn fmtEmit(sink: *FmtSink, fmt: str, ..args) {
    local f: Format = Format(sink, fmt)
    f.check(args.len as usize)
    for a in args { formatArg(&f, a) }
    f.literal()
}

// ---- the String and buffer entry points -------------------------------------------------------

/// The `{}` text of `v` in a new `String`: one body for every `toString` overload, which `fmtWrite` picks by type.
fn textOf<T>(v: T) -> String {
    local out: String = String()
    local sink: FmtSink = FmtSink(FmtString, 0, nil, 0, &out)
    fmtWrite(&sink, v)
    return out
}

/// A new String holding the text of `v`, the same bytes `{}` gives.
/// @cost one allocation of the worst-case length of the value, no more than 400 bytes.
export fn toString(v: i64) -> String { return textOf(v) }
export fn toString(v: u64) -> String { return textOf(v) }
export fn toString(v: f64) -> String { return textOf(v) }
export fn toString(v: bool) -> String { return textOf(v) }
export fn toString(v: str) -> String { return textOf(v) }
export fn toString(p: *u8) -> String { return textOf(p) }

/// Appends `fmt` to `out`; each `{}` takes the next argument and `{{` and `}}` are single braces.
/// @ownership `out` is borrowed and grows; the arguments are borrowed for the call.
export fn fmtAppend(out: *String, fmt: str, ..args) {
    local sink: FmtSink = FmtSink(FmtString, 0, nil, 0, out)
    fmtEmit(&sink, fmt, ..args)
}

/// A new String holding `fmt` with its placeholders replaced. `format` is the documented name; `sprintf` is the same
/// function under the C name a caller may look for.
/// @ownership the arguments are borrowed for the call; the result is a fresh String.
/// @cost one allocation for the text, which grows as it is built.
export fn format(fmt: str, ..args) -> String {
    local out: String = String()
    fmtAppend(&out, fmt, ..args)
    return out
}

export fn sprintf(fmt: str, ..args) -> String {
    return format(fmt, ..args)
}

/// Writes `fmt` into `buf` (`cap` bytes) with its placeholders replaced. The text is cut to `cap - 1` bytes and
/// NUL-terminated when `cap > 0`. Returns the length the full text needs, so a caller can tell that it did not fit and
/// size a second buffer — the `snprintf` rule. `buf` must be at least `cap` writable bytes, or nil with `cap` 0.
/// @safety `buf` must hold `cap` writable bytes.
/// @cost the same work as `format`, an allocation only for a `String` or `Display` argument.
export fn snprintf(buf: *u8, cap: usize, fmt: str, ..args) -> usize {
    local sink: FmtSink = FmtSink(FmtBuffer, 0, buf, cap, nil)
    fmtEmit(&sink, fmt, ..args)
    sink.finish()
    return sink.total
}

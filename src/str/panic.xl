// std/str/panic: panic messages built on the stack, so a failing path allocates nothing and calls no `format`.
// They live beside `fmt` rather than inside it because `collections/vec` imports them while `fmt` imports `String`,
// which imports `Vec`: keeping them here is what lets `fmt` declare the `Writer` interface that `String` implements
// (a module may not import one that imports it). The text is plain ASCII.

/// The capacity of a panic message, the terminating NUL included. A longer message is cut, never overrun.
define PANIC_TEXT_CAP = 256

/// A panic message being built in a fixed stack buffer: `text`, `byte` and `number` append, `raise` panics with it.
/// Every append stops at the capacity, so a long caller text (a format string quoted in a message) is cut rather than
/// written past the buffer.
/// @cost no allocation; the buffer is part of the caller's frame.
export struct PanicText {
    buf: [u8; PANIC_TEXT_CAP]
    at: usize
}

impl PanicText {
    /// Appends one byte, or nothing when only the NUL's place is left.
    fn byte(self: *PanicText, c: u8) {
        if self.at + 1 < PANIC_TEXT_CAP {
            self.buf[self.at] = c
            self.at++
        }
    }

    /// Appends the bytes of `s`, as many as fit.
    fn text(self: *PanicText, s: str) {
        for c in s { self.byte(c) }
    }

    /// Appends the decimal digits of `v`.
    fn number(self: *PanicText, v: u64) {
        local digits: [u8; 20]
        local n: usize = 0
        for local t: u64 = v; n == 0 || t > 0; t /= 10 {
            digits[n] = (t % 10) as u8 + b'0'
            n++
        }
        for i in 0..n { self.byte(digits[n - 1 - i]) }
    }

    /// Panics with the text built so far.
    fn raise(self: *PanicText) {
        self.buf[self.at] = 0
        panic(&self.buf[0])
    }
}

/// An empty message, ready for `text` and `number`.
export fn panicText() -> PanicText {
    return PanicText { buf: [0; PANIC_TEXT_CAP], at: 0 }
}

/// Panics with "Vec: index I out of range for length L".
export fn fmtIndexPanic(i: usize, n: usize) {
    local m: PanicText = panicText()
    m.text("Vec: index ")
    m.number(i as u64)
    m.text(" out of range for length ")
    m.number(n as u64)
    m.raise()
}

/// Panics with "BUFFER: the text needs N bytes": `what` names the buffer that a write did not fit in and `need` is the
/// byte count it asked for. A writer with a fixed capacity (`FmtBuffer`) calls it instead of a `format`.
export fn fmtOverflowPanic(what: str, need: usize) {
    local m: PanicText = panicText()
    m.text(what)
    m.text(": the text needs ")
    m.number(need as u64)
    m.text(" bytes")
    m.raise()
}

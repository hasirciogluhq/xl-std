// std/str/fmt: where formatted text goes — the declarations of the text layer. `Writer` is the one sink interface of
// the library: a destination takes the text it must write and reports how much of it it took. `Display` is the one
// interface a value implements to print itself, so `{}` works for a `String`, a `DateTime` and a user struct alike.
// `FmtSink` implements `Writer` for the three destinations the standard library itself needs (a file descriptor, a
// fixed caller buffer and a `String`), and so do `String` (`str/string`) and `FdWriter` below.
//
// The module cycle: `String` implements `Writer` and `Display`, so `str/string` imports this module. A module may not
// import one that imports it back, yet `FmtSink` must call `String.append` for its `FmtString` kind. The seam is the
// `Writer` interface: `FmtSink.out` is a `*Writer` the caller fills with a `String`, and appending goes through
// `write`, so this module names the interface and never the class. Where a `String` is still named in a signature
// (`Writer.write`, `Display.display`, `byteView`) it is a parameter type only: no value of the kind is built here.
//
// The engine — the placeholder parser, the per-type text, `format`/`sprintf`/`toString` — is `fmtspec`, which imports
// both this module and `str/string` and so may build one. `str/index.xl` re-exports both, so `import "std"` brings in
// all of it.
from "../sys" import sysWrite
from "str" import fromC, fromParts, view
from "string" import String

/// The kind of an `FmtSink`: a file descriptor. A `switch` case needs a `define` constant, so these are macros rather
/// than `const`s; a caller passes them to `FmtSink(...)` and never writes the number.
export define FmtFd = 0
/// The kind of an `FmtSink`: a fixed caller buffer that `snprintf` writes into.
export define FmtBuffer = 1
/// The kind of an `FmtSink`: a `String` that grows.
export define FmtString = 2

/// Where bytes go: the minimal stream contract of the library, which phase 5 builds `Reader`, `File` and the buffered
/// streams on top of. `write` takes text borrowed for the call and returns the number of bytes taken; a negative
/// return means the stream is closed or failed and the caller stops. A writer that never fills up returns the length
/// of `s`.
///
/// @contract `write` reports the count of bytes it accepted — the length of `s` for a writer that never fills up — and
/// @contract a negative return means closed or failed; the caller does not retry a partial accept.
/// @ownership `s` is borrowed for the call only: the writer copies what it keeps and never frees or keeps it.
export interface Writer {
    fn write(self, s: *String) -> isize
}

/// The text of a value, for `{}` and for every format string. A type implements `display` beside itself and the
/// method appends its own text to `out`, so a user struct prints the same way as a number.
///
/// Generic code cannot call an interface method on a bare `T` (E0404, see `xlang-docs/known-limitations.md`), so the
/// engine does not take a generic argument for this interface: a value is wrapped at the call site with
/// `local d: Display = &value`, then passed as `*Display`. An interface value is a fat pointer over an addressable
/// value, so the local is needed; a temporary is not addressable.
///
/// @contract `display` appends the whole text of `self` and nothing else, allocates only if the type's own text does,
/// @contract and never panics on a value the type allows.
/// @ownership `out` is borrowed and grows; `self` is borrowed for the call.
export interface Display {
    fn display(self, out: *String)
}

/// A `String`, a `FmtSink` or any other `Writer` takes the bytes at `p[0..n]` without a copy. The bytes are lent as a
/// `String` view built in this frame: the words `{ ptr, len, cap = 0 }` of `String`'s layout, alive for the whole
/// `write` call. The view is never dropped, so nothing is freed.
/// @ownership `p` is borrowed for the call; the writer copies what it keeps.
/// @safety `p` must point to `n` readable bytes, and a `Writer` must only read its argument (the `Writer` contract).
export fn writeBytes(w: *Writer, p: *u8, n: usize) -> isize {
    local view: [usize; 3] = [p as usize, n, 0]
    return w.write(&view[0] as *String)
}

/// A writer over one file descriptor: what `stdout()` and `stderr()` are built from, and the cheapest destination.
/// One `write` system call per `write`; no buffering, so a caller that formats many pieces should build a `String`.
/// @ownership owns nothing; `fd` stays the caller's to close.
/// @cost one system call per `write`, no allocation.
export class FdWriter {
    fd: i32

    fn init(self, fd: i32) {
        self.fd = fd
    }

    fn write(self, s: *String) -> isize {
        local t: str = s.asStr()
        if t.len == 0 { return 0 }
        return sysWrite(self.fd, t.ptr, t.len)
    }
}

/// A writer sink of three kinds: a file descriptor, a fixed caller buffer, or a `String`. Only the `String` kind
/// reaches an allocator, so printing and `snprintf` make no allocator calls.
/// @ownership owns nothing: the buffer and the target `String` stay the caller's.
export class FmtSink {
    kind: i32
    fd: i32
    buf: *u8     // FmtBuffer: the caller's buffer
    cap: usize    // FmtBuffer: its size in bytes
    total: usize  // FmtBuffer: bytes the full text needs
    out: *String  // FmtString: the target, reached through its `Writer`

    fn init(self, kind: i32, fd: i32, buf: *u8, cap: usize, out: *String) {
        self.kind = kind
        self.fd = fd
        self.buf = buf
        self.cap = cap
        self.total = 0
        self.out = out
    }

    /// Writes the piece `s`. A fd sink makes one write call for it; a buffer sink copies what fits and counts the
    /// rest in `total`; a string sink appends through the `Writer` of the target.
    fn writeBytes(self, s: str) {
        switch self.kind {
        case FmtFd {
            if s.len > 0 { sysWrite(self.fd, s.ptr, s.len) }
        }
        case FmtBuffer {
            for i in 0..s.len {
                // One slot is kept for the terminating NUL, so a full buffer loses the last byte of the text.
                if self.total + 1 < self.cap { self.buf[self.total] = s[i] }
                self.total = self.total + 1
            }
        }
        default {
            local w: Writer = self.out
            writeBytes(&w, s.ptr, s.len)
        }
        }
    }

    /// The `Writer` contract over `writeBytes`: every byte is accepted.
    fn write(self, s: *String) -> isize {
        local t: str = s.asStr()
        self.writeBytes(t)
        return t.len as isize
    }

    /// Ends a buffer sink: writes the NUL at the byte after the text, or at the last byte when the text does not fit.
    /// Does nothing for the other kinds or a zero-sized buffer.
    fn finish(self) {
        if self.kind == FmtBuffer && self.cap > 0 {
            local at: usize = self.total
            if at >= self.cap { at = self.cap - 1 }
            self.buf[at] = 0
        }
    }
}
